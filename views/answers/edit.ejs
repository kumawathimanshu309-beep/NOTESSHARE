<div class="page-container" style="max-width: 700px;">
  
  <div style="margin-bottom: 25px;">
    <a href="/doubts/<%= answer.doubt._id || answer.doubt %>" style="color: var(--muted); font-size: 13px; display: inline-flex; align-items: center; gap: 6px;">
      ← Back to Question
    </a>
  </div>

  <div class="content-card" style="padding: 35px; border-radius: 20px;">
    <h1 style="font-family: 'Sora', sans-serif; font-size: 22px; margin-bottom: 8px;">Edit Teacher Answer</h1>
    <p style="color: var(--muted); font-size: 13px; margin-bottom: 25px;">
      Doubt: <strong><%= answer.doubt.title || 'Student Question' %></strong>
    </p>

    <form action="/answers/<%= answer._id %>?_method=PUT" method="POST">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <div style="margin-bottom: 25px;">
        <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 8px;">Answer Content</label>
        <textarea name="content" rows="6" required minlength="5" maxlength="3000" style="width: 100%; padding: 14px; border-radius: 12px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); color: white; font-family: inherit; font-size: 14px; resize: vertical;"><%= answer.content %></textarea>
      </div>

      <div style="display: flex; gap: 12px; justify-content: flex-end;">
        <a href="/doubts/<%= answer.doubt._id || answer.doubt %>" class="secondary-button" style="padding: 10px 20px;">Cancel</a>
        <button type="submit" class="primary-button" style="padding: 10px 24px;">Update Answer</button>
      </div>
    </form>
  </div>

</div>
