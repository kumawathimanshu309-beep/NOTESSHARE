<div class="page-container" style="max-width: 1100px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
    <div>
      <a href="/admin" style="font-size: 13px; color: var(--muted); text-decoration: none; display: inline-flex; align-items: center; gap: 4px; margin-bottom: 6px;">
        ← Back to Admin Panel
      </a>
      <h1 style="font-family: 'Sora', sans-serif; font-size: 26px; margin: 0; color: white;">
        📚 Resource & Note Moderation
      </h1>
      <p style="color: var(--muted); font-size: 14px; margin-top: 4px;">
        Publish, unpublish, or delete user-submitted study resources.
      </p>
    </div>
  </div>

  <div class="content-card table-responsive" style="padding: 24px; border-radius: 20px;">
    <% if (typeof notes !== 'undefined' && notes.length > 0) { %>
      <table class="responsive-table">
        <thead>
          <tr style="border-bottom: 1px solid var(--border); color: var(--muted);">
            <th style="padding: 12px;">TITLE & SUBJECT</th>
            <th style="padding: 12px;">AUTHOR</th>
            <th style="padding: 12px;">STATUS</th>
            <th style="padding: 12px;">ACTIONS</th>
          </tr>
        </thead>
        <tbody>
          <% notes.forEach(n => { %>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.04);">
              <td style="padding: 14px 12px;">
                <a href="/notes/<%= n._id %>" style="color: white; font-weight: 700; text-decoration: none;" target="_blank">
                  <%= n.title %>
                </a>
                <span style="font-size: 11px; color: var(--lavender); display: block; margin-top: 2px;">
                  <%= n.subject %> • SEM <%= n.semester %> • <%= n.resourceType ? n.resourceType.toUpperCase() : 'PDF' %>
                </span>
              </td>
              <td style="padding: 14px 12px;">
                <%- include('../partials/author_badge', { author: n.author }) %>
              </td>
              <td style="padding: 14px 12px;">
                <% if (n.isPublished) { %>
                  <span style="padding: 4px 10px; border-radius: 12px; background: rgba(34,197,94,0.2); border: 1px solid rgba(34,197,94,0.4); color: #4ADE80; font-weight: 700; font-size: 11px;">PUBLISHED</span>
                <% } else { %>
                  <span style="padding: 4px 10px; border-radius: 12px; background: rgba(239,68,68,0.2); border: 1px solid rgba(239,68,68,0.4); color: #F87171; font-weight: 700; font-size: 11px;">UNPUBLISHED</span>
                <% } %>
              </td>
              <td style="padding: 14px 12px;">
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                  <form action="/admin/notes/<%= n._id %>/toggle-publish?_method=PATCH" method="POST" style="margin: 0;">
                    <button type="submit" class="secondary-button" style="padding: 6px 12px; font-size: 11px;">
                      <%= n.isPublished ? 'Unpublish' : 'Publish' %>
                    </button>
                  </form>
                  <form action="/admin/notes/<%= n._id %>?_method=DELETE" method="POST" style="margin: 0;" onsubmit="return confirm('Delete this note?');">
                    <button type="submit" class="secondary-button" style="padding: 6px 12px; font-size: 11px; color: #F87171;">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p style="color: var(--muted); font-size: 14px; text-align: center; margin: 20px 0;">No active notes found.</p>
    <% } %>
  </div>
</div>
