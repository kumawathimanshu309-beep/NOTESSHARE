<div class="page-container" style="max-width: 1100px;">
  
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
    <div>
      <a href="/admin" style="font-size: 13px; color: var(--muted); text-decoration: none; display: inline-flex; align-items: center; gap: 4px; margin-bottom: 6px;">
        ← Back to Admin Panel
      </a>
      <h1 style="font-family: 'Sora', sans-serif; font-size: 26px; margin: 0; color: white;">
        👥 User & Role Management
      </h1>
      <p style="color: var(--muted); font-size: 14px; margin-top: 4px;">
        Manage student, teacher, and administrator accounts across StudyShare.
      </p>
    </div>
    <div>
      <a href="/admin/teacher-requests" class="primary-button" style="padding: 8px 16px; font-size: 12px; text-decoration: none;">
        📋 Teacher Governance & Requests
      </a>
    </div>
  </div>

  <!-- Search & Role Filter Bar -->
  <div class="content-card" style="padding: 20px; border-radius: 16px; margin-bottom: 25px;">
    <form action="/admin/users" method="GET" style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
      <input type="text" name="search" value="<%= query.search || '' %>" placeholder="Search by name, username or email..." style="flex: 1; min-width: 200px; padding: 10px 14px; border-radius: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border); color: white; font-size: 13px; outline: none;">
      
      <select name="role" style="padding: 10px 14px; border-radius: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border); color: white; font-size: 13px; outline: none;">
        <option value="">All Roles</option>
        <option value="student" <%= query.role === 'student' ? 'selected' : '' %>>Students</option>
        <option value="teacher" <%= query.role === 'teacher' ? 'selected' : '' %>>Teachers</option>
        <option value="admin" <%= query.role === 'admin' ? 'selected' : '' %>>Admins</option>
      </select>

      <button type="submit" class="primary-button" style="padding: 10px 18px; font-size: 13px;">
        Filter Users
      </button>
      <% if (query.search || query.role) { %>
        <a href="/admin/users" class="secondary-button" style="padding: 10px 14px; font-size: 13px;">Clear</a>
      <% } %>
    </form>
  </div>

  <!-- Users Table -->
  <div class="content-card" style="padding: 24px; border-radius: 20px; overflow-x: auto;">
    <% if (typeof users !== 'undefined' && users.length > 0) { %>
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
        <thead>
          <tr style="border-bottom: 1px solid var(--border); color: var(--muted);">
            <th style="padding: 12px;">USER</th>
            <th style="padding: 12px;">USERNAME</th>
            <th style="padding: 12px;">EMAIL</th>
            <th style="padding: 12px;">ROLE</th>
            <th style="padding: 12px;">CHANGE ROLE</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.04);">
              <td style="padding: 14px 12px;">
                <strong style="color: white; display: block;"><%= u.name %></strong>
                <span style="font-size: 11px; color: var(--muted);">Joined <%= new Date(u.createdAt).toLocaleDateString() %></span>
              </td>
              <td style="padding: 14px 12px; color: var(--lavender);">
                @<%= u.username %>
              </td>
              <td style="padding: 14px 12px; color: var(--text);">
                <%= u.email %>
              </td>
              <td style="padding: 14px 12px;">
                <% if (u.role === 'admin') { %>
                  <span style="padding: 4px 10px; border-radius: 12px; background: rgba(239,68,68,0.2); border: 1px solid rgba(239,68,68,0.4); color: #F87171; font-weight: 700; font-size: 11px;">🛡️ ADMIN</span>
                <% } else if (u.role === 'teacher') { %>
                  <span style="padding: 4px 10px; border-radius: 12px; background: rgba(124,58,237,0.2); border: 1px solid rgba(168,85,247,0.4); color: #C4B5FD; font-weight: 700; font-size: 11px;">🎓 TEACHER</span>
                <% } else { %>
                  <span style="padding: 4px 10px; border-radius: 12px; background: rgba(59,130,246,0.2); border: 1px solid rgba(59,130,246,0.4); color: #60A5FA; font-weight: 700; font-size: 11px;">📚 STUDENT</span>
                <% } %>
              </td>
              <td style="padding: 14px 12px;">
                <form action="/admin/users/<%= u._id %>/role?_method=PATCH" method="POST" style="display: flex; gap: 6px; align-items: center; margin: 0;">
                  <select name="role" style="padding: 6px 10px; border-radius: 8px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); color: white; font-size: 12px; outline: none;">
                    <option value="student" <%= u.role === 'student' ? 'selected' : '' %>>Student</option>
                    <option value="teacher" <%= u.role === 'teacher' ? 'selected' : '' %>>Teacher</option>
                    <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                  </select>
                  <button type="submit" class="secondary-button" style="padding: 6px 12px; font-size: 11px;">Update</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <!-- Pagination -->
      <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
        <div style="display: flex; justify-content: center; gap: 8px; margin-top: 25px; align-items: center;">
          <% if (page > 1) { %>
            <a href="/admin/users?page=<%= page - 1 %>&role=<%= query.role || '' %>&search=<%= encodeURIComponent(query.search || '') %>" class="secondary-button" style="padding: 6px 12px; font-size: 12px;">← Previous</a>
          <% } %>
          <span style="font-size: 13px; color: var(--muted);">Page <%= page %> of <%= totalPages %></span>
          <% if (page < totalPages) { %>
            <a href="/admin/users?page=<%= page + 1 %>&role=<%= query.role || '' %>&search=<%= encodeURIComponent(query.search || '') %>" class="secondary-button" style="padding: 6px 12px; font-size: 12px;">Next →</a>
          <% } %>
        </div>
      <% } %>

    <% } else { %>
      <p style="color: var(--muted); font-size: 14px; text-align: center; margin: 20px 0;">No user accounts match your search query.</p>
    <% } %>
  </div>

</div>
