<div class="page-container" style="max-width: 1100px;">
  
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
    <div>
      <a href="/admin" style="font-size: 13px; color: var(--muted); text-decoration: none; display: inline-flex; align-items: center; gap: 4px; margin-bottom: 6px;">
        ← Back to Admin Panel
      </a>
      <h1 style="font-family: 'Sora', sans-serif; font-size: 26px; margin: 0; color: white;">
        ℹ️ About Cards Management
      </h1>
      <p style="color: var(--muted); font-size: 14px; margin-top: 4px;">
        Configure, toggle active status, and reorder platform mission and principle cards displayed on the About page.
      </p>
    </div>
  </div>

  <!-- Create New About Card Form -->
  <div class="content-card" style="padding: 25px; border-radius: 20px; margin-bottom: 30px;">
    <h3 style="font-family: 'Sora', sans-serif; font-size: 18px; margin: 0 0 15px 0; color: white;">
      ➕ Add New About Card
    </h3>
    
    <form action="/admin/about-cards" method="POST" style="display: flex; flex-direction: column; gap: 14px;">
      <div style="display: flex; gap: 15px; flex-wrap: wrap;">
        <div style="flex: 2; min-width: 200px;">
          <label style="font-size: 12px; color: var(--muted); font-weight: 600; display: block; margin-bottom: 4px;">Card Title</label>
          <input type="text" name="title" required maxlength="100" placeholder="e.g. Our Mission / Community Principles" style="width: 100%; padding: 10px 14px; border-radius: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border); color: white; font-size: 13px; outline: none;">
        </div>
        <div style="flex: 1; min-width: 100px;">
          <label style="font-size: 12px; color: var(--muted); font-weight: 600; display: block; margin-bottom: 4px;">Icon / Emoji</label>
          <input type="text" name="icon" value="🎯" required placeholder="🎯, 💡, 🌐, 🤝, 🛡️" style="width: 100%; padding: 10px 14px; border-radius: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border); color: white; font-size: 13px; outline: none;">
        </div>
        <div style="flex: 1; min-width: 100px;">
          <label style="font-size: 12px; color: var(--muted); font-weight: 600; display: block; margin-bottom: 4px;">Display Order</label>
          <input type="number" name="order" value="1" min="0" style="width: 100%; padding: 10px 14px; border-radius: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border); color: white; font-size: 13px; outline: none;">
        </div>
      </div>

      <div>
        <label style="font-size: 12px; color: var(--muted); font-weight: 600; display: block; margin-bottom: 4px;">Content / Description</label>
        <textarea name="description" required rows="3" maxlength="1000" placeholder="Detailed description of platform mission, core values, or guidance..." style="width: 100%; padding: 10px 14px; border-radius: 10px; background: rgba(0,0,0,0.3); border: 1px solid var(--border); color: white; font-size: 13px; outline: none; resize: vertical;"></textarea>
      </div>

      <div>
        <button type="submit" class="primary-button" style="padding: 10px 20px; font-size: 13px;">
          Create About Card
        </button>
      </div>
    </form>
  </div>

  <!-- Cards List -->
  <div class="content-card" style="padding: 25px; border-radius: 20px;">
    <h3 style="font-family: 'Sora', sans-serif; font-size: 18px; margin: 0 0 18px 0; color: white;">
      📋 Managed About Cards
    </h3>

    <% if (typeof cards !== 'undefined' && cards.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 14px;">
        <% cards.forEach(c => { %>
          <div style="padding: 18px; border-radius: 14px; background: rgba(255,255,255,0.02); border: 1px solid var(--border); display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 15px; <%= !c.isActive ? 'opacity: 0.65;' : '' %>">
            
            <div style="flex: 1; min-width: 250px;">
              <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px; flex-wrap: wrap;">
                <span style="font-size: 22px;"><%= c.icon %></span>
                <strong style="font-size: 16px; color: white;"><%= c.title %></strong>
                <span style="font-size: 11px; color: var(--muted); background: rgba(255,255,255,0.05); padding: 2px 8px; border-radius: 10px;">Order: <%= c.order %></span>
                
                <% if (c.isActive) { %>
                  <span style="padding: 2px 8px; border-radius: 10px; background: rgba(34,197,94,0.2); color: #4ADE80; font-size: 11px; font-weight: 700;">Active</span>
                <% } else { %>
                  <span style="padding: 2px 8px; border-radius: 10px; background: rgba(239,68,68,0.2); color: #F87171; font-size: 11px; font-weight: 700;">Inactive</span>
                <% } %>
              </div>

              <p style="color: var(--text); font-size: 13px; margin: 4px 0 8px 0; line-height: 1.6;">
                <%= c.description %>
              </p>
            </div>

            <!-- Action Controls -->
            <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
              <a href="/admin/about-cards/<%= c._id %>/edit" class="secondary-button" style="padding: 6px 12px; font-size: 12px; text-decoration: none;">
                ✏️ Edit
              </a>

              <form action="/admin/about-cards/<%= c._id %>/toggle-active" method="POST" style="margin: 0;">
                <button type="submit" class="secondary-button" style="padding: 6px 12px; font-size: 12px;">
                  <%= c.isActive ? 'Deactivate' : 'Activate' %>
                </button>
              </form>

              <form action="/admin/about-cards/<%= c._id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Delete this About Card?');">
                <button type="submit" class="secondary-button" style="padding: 6px 12px; font-size: 12px; color: #F87171;">
                  Delete
                </button>
              </form>
            </div>

          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p style="color: var(--muted); font-size: 14px; text-align: center; margin: 20px 0;">No custom About Cards configured yet. Public visitors will see default platform mission & principles.</p>
    <% } %>
  </div>

</div>
