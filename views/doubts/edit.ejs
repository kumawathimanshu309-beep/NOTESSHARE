<div class="page-container" style="max-width: 750px;">
  
  <div style="margin-bottom: 25px;">
    <a href="/doubts/<%= doubt._id %>" style="color: var(--muted); font-size: 13px; display: inline-flex; align-items: center; gap: 6px;">
      ← Back to Doubt
    </a>
  </div>

  <div class="content-card" style="padding: 35px; border-radius: 20px;">
    <h1 style="font-family: 'Sora', sans-serif; font-size: 24px; margin-bottom: 8px;">Edit Student Doubt</h1>
    <p style="color: var(--muted); font-size: 14px; margin-bottom: 25px;">Update your doubt details.</p>

    <form action="/doubts/<%= doubt._id %>?_method=PUT" method="POST">
      
      <div style="margin-bottom: 20px;">
        <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 8px;">Title</label>
        <input type="text" name="title" value="<%= doubt.title %>" required minlength="5" maxlength="150" style="width: 100%; padding: 14px; border-radius: 10px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); color: white; font-size: 14px;">
      </div>

      <div class="form-grid-2col">
        <div>
          <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 8px;">Subject</label>
          <select name="subject" required style="width: 100%; padding: 14px; border-radius: 10px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); color: white; font-size: 14px;">
            <option value="Computer Science" <%= doubt.subject === 'Computer Science' ? 'selected' : '' %>>Computer Science</option>
            <option value="Mathematics" <%= doubt.subject === 'Mathematics' ? 'selected' : '' %>>Mathematics</option>
            <option value="Physics" <%= doubt.subject === 'Physics' ? 'selected' : '' %>>Physics</option>
            <option value="Electronics" <%= doubt.subject === 'Electronics' ? 'selected' : '' %>>Electronics</option>
            <option value="General" <%= doubt.subject === 'General' ? 'selected' : '' %>>General</option>
          </select>
        </div>

        <div>
          <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 8px;">Category</label>
          <input type="text" name="category" value="<%= doubt.category %>" style="width: 100%; padding: 14px; border-radius: 10px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); color: white; font-size: 14px;">
        </div>
      </div>

      <div style="margin-bottom: 20px;">
        <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 8px;">Description</label>
        <textarea name="description" rows="6" required minlength="10" maxlength="2000" style="width: 100%; padding: 14px; border-radius: 10px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); color: white; font-size: 14px; font-family: inherit; resize: vertical;"><%= doubt.description %></textarea>
      </div>

      <div style="margin-bottom: 30px;">
        <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 8px;">Tags</label>
        <input type="text" name="tags" value="<%= doubt.tags ? doubt.tags.join(', ') : '' %>" style="width: 100%; padding: 14px; border-radius: 10px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); color: white; font-size: 14px;">
      </div>

      <div style="display: flex; gap: 15px; justify-content: flex-end;">
        <a href="/doubts/<%= doubt._id %>" class="secondary-button" style="padding: 12px 24px;">Cancel</a>
        <button type="submit" class="primary-button" style="padding: 12px 28px;">Update Doubt</button>
      </div>

    </form>
  </div>

</div>
