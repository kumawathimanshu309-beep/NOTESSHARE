<div class="page-container" style="max-width: 900px;">
  
  <div style="margin-bottom: 25px;">
    <a href="/doubts" style="color: var(--muted); font-size: 13px; display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
      ← Back to Doubts
    </a>
  </div>

  <!-- Doubt Question Card -->
  <div class="content-card" style="padding: 35px; border-radius: 20px; margin-bottom: 30px;">
    <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 15px; flex-wrap: wrap;">
      <% if (doubt.status === 'resolved') { %>
        <span style="padding: 4px 12px; border-radius: 20px; background: rgba(34,197,94,0.2); border: 1px solid rgba(34,197,94,0.4); color: #4ADE80; font-size: 11px; font-weight: 700; text-transform: uppercase;">
          ✓ Resolved
        </span>
      <% } else if (doubt.status === 'answered') { %>
        <span style="padding: 4px 12px; border-radius: 20px; background: rgba(59,130,246,0.2); border: 1px solid rgba(59,130,246,0.4); color: #60A5FA; font-size: 11px; font-weight: 700; text-transform: uppercase;">
          💬 Answered
        </span>
      <% } else { %>
        <span style="padding: 4px 12px; border-radius: 20px; background: rgba(234,179,8,0.2); border: 1px solid rgba(234,179,8,0.4); color: #FDE047; font-size: 11px; font-weight: 700; text-transform: uppercase;">
          ⏳ Open
        </span>
      <% } %>

      <span style="padding: 4px 12px; border-radius: 20px; background: rgba(124,58,237,0.15); border: 1px solid rgba(168,85,247,0.3); color: #C4B5FD; font-size: 11px; font-weight: 700; text-transform: uppercase;">
        📚 <%= doubt.subject %>
      </span>

      <% if (doubt.topic && doubt.topic !== 'General') { %>
        <span style="padding: 4px 12px; border-radius: 20px; background: rgba(59,130,246,0.15); border: 1px solid rgba(96,165,250,0.3); color: #93C5FD; font-size: 11px; font-weight: 700;">
          📌 <%= doubt.topic %>
        </span>
      <% } %>
    </div>

    <h1 style="font-family: 'Sora', sans-serif; font-size: 28px; line-height: 1.3; margin-bottom: 15px; color: white;">
      <%= doubt.title %>
    </h1>

    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 25px; padding-bottom: 20px; border-bottom: 1px solid var(--border);">
      <div style="width: 38px; height: 38px; border-radius: 50%; background: var(--gradient); display: grid; place-items: center; font-size: 16px; font-weight: 700; color: white;">
        <%= doubt.student ? doubt.student.name.charAt(0).toUpperCase() : 'S' %>
      </div>
      <div>
        <a href="/profile/<%= doubt.student ? doubt.student.username : '' %>" style="font-weight: 600; font-size: 14px; color: white; text-decoration: none;">
          <%= doubt.student ? doubt.student.name : 'Student' %>
        </a>
        <span style="font-size: 12px; color: var(--muted); margin-left: 8px;">@<%= doubt.student ? doubt.student.username : 'student' %> • Asked <%= new Date(doubt.createdAt).toLocaleDateString() %></span>
      </div>
    </div>

    <div style="color: var(--text); font-size: 15px; line-height: 1.8; white-space: pre-line; margin-bottom: 25px;">
      <%= doubt.description %>
    </div>

    <% if (doubt.attachment) { %>
      <div style="margin-bottom: 25px; padding: 12px 16px; border-radius: 12px; background: rgba(255,255,255,0.03); border: 1px solid var(--border); display: inline-flex; align-items: center; gap: 12px;">
        <span style="font-size: 20px;">📎</span>
        <div>
          <strong style="font-size: 13px; color: white; display: block;">Attachment File Included</strong>
          <a href="<%= doubt.attachment %>" target="_blank" rel="noopener noreferrer" style="font-size: 12px; color: var(--lavender); font-weight: 600; text-decoration: none;">View Attachment File →</a>
        </div>
      </div>
    <% } %>

    <% if (doubt.tags && doubt.tags.length > 0) { %>
      <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px;">
        <% doubt.tags.forEach(tag => { %>
          <span style="font-size: 11px; color: var(--muted); background: rgba(255,255,255,0.04); padding: 4px 10px; border-radius: 6px;">#<%= tag %></span>
        <% }) %>
      </div>
    <% } %>

    <!-- Student Owner / Admin Controls -->
    <% if (typeof isDoubtOwner !== 'undefined' && (isDoubtOwner || isAdmin)) { %>
      <div style="display: flex; gap: 12px; margin-top: 20px; padding-top: 15px; border-top: 1px solid var(--border);">
        <a href="/doubts/<%= doubt._id %>/edit" class="secondary-button" style="padding: 6px 14px; font-size: 12px;">✏️ Edit Doubt</a>
        <form action="/doubts/<%= doubt._id %>?_method=DELETE" method="POST" style="display: inline;" onsubmit="return confirm('Delete this doubt?');">
          <button type="submit" class="secondary-button" style="padding: 6px 14px; font-size: 12px; color: #F87171; border-color: rgba(239,68,68,0.3);">🗑️ Delete</button>
        </form>
      </div>
    <% } %>
  </div>

  <!-- Teacher Answer Form Section -->
  <% if (typeof isTeacher !== 'undefined' && isTeacher) { %>
    <div class="content-card" style="padding: 30px; border-radius: 20px; margin-bottom: 35px; border-color: rgba(168,85,247,0.4);">
      <h3 style="font-family: 'Sora', sans-serif; font-size: 18px; margin-bottom: 12px; color: var(--lavender);">
        🎓 Answer as a Verified Teacher
      </h3>
      
      <form action="/doubts/<%= doubt._id %>/answers" method="POST">
        <div style="margin-bottom: 15px;">
          <textarea name="content" rows="5" required minlength="5" maxlength="3000" placeholder="Provide a detailed, step-by-step solution or explanation for the student..." style="width: 100%; padding: 14px; border-radius: 12px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); color: white; font-family: inherit; font-size: 14px; resize: vertical; outline: none;"></textarea>
        </div>
        <button type="submit" class="primary-button" style="padding: 10px 22px; font-size: 13px;">
          Submit Answer
        </button>
      </form>
    </div>
  <% } else if (typeof isAuthenticated !== 'undefined' && !isAuthenticated) { %>
    <div class="content-card" style="padding: 20px; border-radius: 16px; margin-bottom: 30px; text-align: center;">
      <p style="color: var(--muted); font-size: 14px; margin: 0;">Are you a teacher or peer student? <a href="/auth/login" style="color: var(--lavender); font-weight: 600;">Log in to answer</a>.</p>
    </div>
  <% } %>

  <!-- Answers List Section -->
  <div id="answers">
    <h2 style="font-family: 'Sora', sans-serif; font-size: 22px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; color: white;">
      Answers & Solutions <span style="font-size: 14px; color: var(--muted); font-weight: normal;">(<%= typeof answers !== 'undefined' ? answers.length : 0 %>)</span>
    </h2>

    <% if (typeof answers !== 'undefined' && answers.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 20px;">
        <% answers.forEach(answer => { %>
          <div class="content-card" style="padding: 25px; border-radius: 16px; <%= answer.isAccepted ? 'border-color: rgba(34,197,94,0.5); background: rgba(16,185,129,0.04);' : '' %>">
            <% if (answer.isAccepted) { %>
              <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 20px; background: rgba(34,197,94,0.2); border: 1px solid rgba(34,197,94,0.4); color: #4ADE80; font-size: 11px; font-weight: 700; margin-bottom: 12px;">
                ✓ ACCEPTED SOLUTION
              </div>
            <% } %>

            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
              <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 36px; height: 36px; border-radius: 50%; background: var(--gradient); display: grid; place-items: center; font-weight: 700; color: white; font-size: 14px;">
                  <%= answer.author ? answer.author.name.charAt(0).toUpperCase() : 'T' %>
                </div>
                <div>
                  <div style="display: flex; align-items: center; gap: 6px;">
                    <a href="/profile/<%= answer.author ? answer.author.username : '' %>" style="font-weight: 600; font-size: 14px; color: white; text-decoration: none;">
                      <%= answer.author ? answer.author.name : 'Teacher' %>
                    </a>
                    <% if (answer.author && answer.author.role === 'teacher') { %>
                      <span style="font-size: 10px; padding: 2px 6px; border-radius: 4px; background: rgba(124,58,237,0.25); color: #C4B5FD; font-weight: 700;">TEACHER</span>
                    <% } %>
                  </div>
                  <span style="font-size: 11px; color: var(--muted);"><%= new Date(answer.createdAt).toLocaleString() %></span>
                </div>
              </div>

              <% if (isDoubtOwner && !answer.isAccepted) { %>
                <form action="/answers/<%= answer._id %>/accept" method="POST" style="margin: 0;">
                  <button type="submit" class="secondary-button" style="padding: 6px 14px; font-size: 11px; color: #4ADE80; border-color: rgba(34,197,94,0.4);">
                    ✓ Accept as Solution
                  </button>
                </form>
              <% } %>
            </div>

            <div style="color: var(--text); font-size: 14px; line-height: 1.7; white-space: pre-line;">
              <%= answer.content %>
            </div>

            <div style="display: flex; align-items: center; gap: 12px; margin-top: 15px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.05); flex-wrap: wrap;">
              <% 
                const currentUserStr = currentUser ? String(currentUser._id) : '';
                const hasVotedHelpful = currentUser && Array.isArray(answer.helpfulVotes) && answer.helpfulVotes.some(id => String(id._id || id) === currentUserStr);
                const hasVotedUnhelpful = currentUser && Array.isArray(answer.unhelpfulVotes) && answer.unhelpfulVotes.some(id => String(id._id || id) === currentUserStr);
                const helpfulCount = typeof answer.helpfulCount === 'number' ? answer.helpfulCount : (Array.isArray(answer.helpfulVotes) ? answer.helpfulVotes.length : 0);
                const unhelpfulCount = Array.isArray(answer.unhelpfulVotes) ? answer.unhelpfulVotes.length : 0;
              %>
              <form action="/answers/<%= answer._id %>/vote" method="POST" style="display: inline-flex; align-items: center; margin: 0;">
                <input type="hidden" name="voteType" value="helpful">
                <button type="submit" class="secondary-button" style="padding: 4px 10px; font-size: 11px; cursor: pointer; <%= hasVotedHelpful ? 'background: rgba(34,197,94,0.25); color: #4ADE80; border-color: rgba(34,197,94,0.5);' : '' %>">
                  👍 Helpful (<%= helpfulCount %>)
                </button>
              </form>
              <form action="/answers/<%= answer._id %>/vote" method="POST" style="display: inline-flex; align-items: center; margin: 0;">
                <input type="hidden" name="voteType" value="unhelpful">
                <button type="submit" class="secondary-button" style="padding: 4px 10px; font-size: 11px; cursor: pointer; <%= hasVotedUnhelpful ? 'background: rgba(239,68,68,0.25); color: #F87171; border-color: rgba(239,68,68,0.5);' : '' %>">
                  👎 Not Helpful (<%= unhelpfulCount %>)
                </button>
              </form>

              <% if (answer.author && ((answer.author._id && answer.author._id.equals(currentUser ? currentUser._id : '')) || String(answer.author) === currentUserStr || isAdmin)) { %>
                <span style="color: var(--muted); font-size: 11px;">•</span>
                <a href="/answers/<%= answer._id %>/edit" style="font-size: 11px; color: var(--muted); text-decoration: none;">✏️ Edit</a>
                <form action="/answers/<%= answer._id %>?_method=DELETE" method="POST" style="display: inline;" onsubmit="return confirm('Delete this answer?');">
                  <button type="submit" style="background: none; border: none; font-size: 11px; color: #F87171; cursor: pointer; padding: 0;">🗑️ Delete</button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="content-card" style="padding: 30px; text-align: center; color: var(--muted); border-radius: 16px;">
        <p style="margin: 0; font-size: 14px;">No answers posted yet for this doubt.</p>
      </div>
    <% } %>
  </div>

</div>
