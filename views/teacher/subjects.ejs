<div class="page-container" style="max-width: 1200px;">
  
  <!-- Dashboard Header Bar with Search & Profile Avatar -->
  <div style="display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 1px solid var(--border);">
    <div style="display: flex; align-items: center; gap: 12px;">
      <a href="/" style="font-family: 'Sora', sans-serif; font-size: 20px; font-weight: 800; color: white; text-decoration: none; letter-spacing: 0.5px;">
        STUDY<span class="gradient-text">SHARE</span>
      </a>
    </div>

    <!-- Working Header Search Form -->
    <form action="/notes" method="GET" style="flex: 1; max-width: 480px; min-width: 260px; display: flex; align-items: center; background: rgba(0,0,0,0.4); border: 1px solid var(--border); border-radius: 12px; padding: 4px 12px;">
      <span style="color: var(--muted); font-size: 14px; margin-right: 8px;">🔍</span>
      <input type="text" name="search" placeholder="Search notes by subject, title, topic..." style="width: 100%; background: transparent; border: none; outline: none; color: white; font-size: 13px; padding: 8px 0;">
      <button type="submit" class="secondary-button" style="padding: 4px 12px; font-size: 11px; margin-left: 6px; flex-shrink: 0;">Search</button>
    </form>

    <!-- Top-Right Functional User Profile Button -->
    <a href="/profile" style="display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,0.03); border: 1px solid var(--border); padding: 6px 14px; border-radius: 20px; text-decoration: none;" onmouseover="this.style.borderColor='var(--lavender)'" onmouseout="this.style.borderColor='var(--border)'">
      <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--gradient); display: grid; place-items: center; font-size: 14px; font-weight: 700; color: white; overflow: hidden; flex-shrink: 0;">
        <% if (teacher.avatar && teacher.avatar !== '/images/logo.png' && (teacher.avatar.startsWith('/') || teacher.avatar.startsWith('http://') || teacher.avatar.startsWith('https://'))) { %>
          <img src="<%= teacher.avatar %>" alt="<%= teacher.name %>" style="width: 100%; height: 100%; object-fit: cover;">
        <% } else { %>
          <%= teacher.name ? teacher.name.charAt(0).toUpperCase() : (teacher.username ? teacher.username.charAt(0).toUpperCase() : 'T') %>
        <% } %>
      </div>
      <span style="color: white; font-size: 13px; font-weight: 600;"><%= teacher.name || teacher.username %></span>
    </a>
  </div>

  <!-- Dashboard Main Layout Grid: Left Sidebar + Right Main Content -->
  <div class="layout-grid-2col" style="grid-template-columns: 240px 1fr; align-items: start; gap: 30px;">
    
    <!-- Left Navigation Sidebar -->
    <aside style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 20px; padding: 20px;">
      <div style="font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; margin-bottom: 12px; letter-spacing: 0.5px;">Teacher Navigation</div>
      
      <nav style="display: flex; flex-direction: column; gap: 6px;">
        <a href="/dashboard" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 10px; color: var(--muted); font-size: 13px; text-decoration: none;" onmouseover="this.style.color='white'; this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.color='var(--muted)'; this.style.background='transparent'">
          📊 Overview
        </a>
        <a href="/teacher/subjects" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 10px; background: rgba(124,58,237,0.15); border: 1px solid rgba(168,85,247,0.3); color: white; font-size: 13px; font-weight: 600; text-decoration: none;">
          📚 My Subjects
        </a>
        <a href="/notes" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 10px; color: var(--muted); font-size: 13px; text-decoration: none;" onmouseover="this.style.color='white'; this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.color='var(--muted)'; this.style.background='transparent'">
          🧭 Explore Notes
        </a>
        <a href="/notes" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 10px; color: var(--muted); font-size: 13px; text-decoration: none;" onmouseover="this.style.color='white'; this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.color='var(--muted)'; this.style.background='transparent'">
          📚 Teaching Resources
        </a>
        <a href="/doubts" style="display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 10px; color: var(--muted); font-size: 13px; text-decoration: none;" onmouseover="this.style.color='white'; this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.color='var(--muted)'; this.style.background='transparent'">
          ❓ Student Doubts
        </a>
        <a href="/notifications" style="display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; border-radius: 10px; color: var(--muted); font-size: 13px; text-decoration: none;" onmouseover="this.style.color='white'; this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.color='var(--muted)'; this.style.background='transparent'">
          <span>🔔 Notifications</span>
          <% if (typeof unreadNotificationsCount !== 'undefined' && unreadNotificationsCount > 0) { %>
            <span style="font-size: 10px; padding: 2px 6px; border-radius: 8px; background: #EF4444; color: white; font-weight: 700;"><%= unreadNotificationsCount %></span>
          <% } %>
        </a>
      </nav>

      <div style="border-top: 1px solid var(--border); margin-top: 20px; padding-top: 15px;">
        <form action="/auth/logout" method="POST">
          <button type="submit" style="width: 100%; background: transparent; border: 1px solid rgba(239,68,68,0.2); color: #F87171; padding: 8px; border-radius: 8px; cursor: pointer; font-size: 12px;">
            Log Out
          </button>
        </form>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main>
      
      <!-- Welcome Header Banner -->
      <div class="content-card" style="padding: 28px; border-radius: 20px; margin-bottom: 25px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; position: relative; overflow: hidden;">
        <div style="position: absolute; top: -40px; right: -40px; width: 180px; height: 180px; background: var(--gradient); opacity: 0.12; filter: blur(50px); border-radius: 50%; pointer-events: none;"></div>
        
        <div>
          <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 4px;">
            <span style="font-size: 11px; font-weight: 700; color: #C4B5FD; text-transform: uppercase; letter-spacing: 0.5px;">TEACHER PORTAL</span>
            <span style="font-size: 10px; padding: 2px 8px; border-radius: 10px; background: rgba(34,197,94,0.2); color: #4ADE80; font-weight: 700;">ASSIGNED SUBJECTS</span>
          </div>
          <h1 style="font-family: 'Sora', sans-serif; font-size: 24px; margin: 0; color: white;">
            My Subjects & Topics (<%= subjects ? subjects.length : 0 %>)
          </h1>
          <p style="font-size: 13px; color: var(--muted); margin: 6px 0 0 0;">
            Subjects officially assigned to you. Manage topics and author resources under your approved curriculum.
          </p>
        </div>

        <a href="/notes/new" class="primary-button" style="padding: 10px 20px; font-size: 13px; display: inline-flex; align-items: center; gap: 6px;">
          + Upload Resource
        </a>
      </div>

      <!-- Subjects Cards Grid -->
      <% if (subjects && subjects.length > 0) { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-bottom: 35px;">
          <% subjects.forEach(s => { %>
            <div class="content-card" style="padding: 24px; border-radius: 18px; display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--border); transition: transform 0.2s, border-color 0.2s;" onmouseover="this.style.borderColor='var(--lavender)'; this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--border)'; this.style.transform='translateY(0)'">
              <div>
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; gap: 8px;">
                  <span style="font-size: 10px; padding: 3px 10px; border-radius: 10px; background: rgba(124,58,237,0.2); border: 1px solid rgba(168,85,247,0.3); color: #C4B5FD; font-weight: 700; text-transform: uppercase;">
                    <%= s.department || 'General' %>
                  </span>
                  <% if (s.code) { %>
                    <span style="font-size: 11px; color: var(--muted); font-weight: 600;">
                      <%= s.code %>
                    </span>
                  <% } %>
                </div>

                <h3 style="font-family: 'Sora', sans-serif; font-size: 17px; margin: 0 0 8px 0; color: white; line-height: 1.35;">
                  <%= s.name %>
                </h3>

                <% if (s.description) { %>
                  <p style="font-size: 12px; color: var(--muted); margin: 0 0 14px 0; line-height: 1.45;">
                    <%= s.description.length > 100 ? s.description.substring(0, 100) + '...' : s.description %>
                  </p>
                <% } %>
              </div>

              <div>
                <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 16px; font-size: 12px;">
                  <span style="color: var(--muted);">Curriculum Topics:</span>
                  <strong style="color: white; font-size: 14px; font-family: 'Sora', sans-serif;">
                    <%= s.topicCount || 0 %> <%= s.topicCount === 1 ? 'Topic' : 'Topics' %>
                  </strong>
                </div>

                <div style="display: flex; gap: 8px;">
                  <a href="/teacher/subjects/<%= s._id %>/topics" class="primary-button" style="flex: 1; justify-content: center; padding: 9px 14px; font-size: 12px; text-decoration: none;">
                    Manage Topics →
                  </a>
                  <a href="/notes/new?subject=<%= encodeURIComponent(s.name) %>" class="secondary-button" style="padding: 9px 12px; font-size: 12px; text-decoration: none;" title="Create resource for this subject">
                    + Resource
                  </a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="content-card" style="padding: 40px; border-radius: 20px; text-align: center; border: 1px dashed var(--border);">
          <div style="font-size: 40px; margin-bottom: 14px;">📚</div>
          <h2 style="font-family: 'Sora', sans-serif; font-size: 18px; margin: 0 0 8px 0; color: white;">No Subjects Assigned Yet</h2>
          <p style="color: var(--muted); font-size: 13px; max-width: 480px; margin: 0 auto 20px auto; line-height: 1.5;">
            You currently do not have any teaching subjects assigned to your profile. Please apply for subject qualification or reach out to the Department Administrator.
          </p>
          <a href="/dashboard" class="secondary-button" style="display: inline-flex; padding: 8px 18px; font-size: 13px; text-decoration: none;">
            Return to Dashboard
          </a>
        </div>
      <% } %>

    </main>
  </div>

</div>
