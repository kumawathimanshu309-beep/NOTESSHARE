<div class="page-container resource-detail-container">

  <!-- Breadcrumb Navigation -->
  <nav class="resource-breadcrumb" aria-label="Breadcrumb">
    <a href="/notes" class="breadcrumb-link">Explore Notes</a>
    <span class="breadcrumb-sep" aria-hidden="true">/</span>
    <a href="/notes?subject=<%= encodeURIComponent(note.subject) %>" class="breadcrumb-link highlight"><%= note.subject %></a>
    <span class="breadcrumb-sep" aria-hidden="true">/</span>
    <span class="breadcrumb-current">Semester <%= note.semester %></span>
  </nav>

  <!-- Resource Header Card -->
  <header class="content-card resource-header-card">
    <!-- Badges & Dropdown Management Row -->
    <div class="header-badges-bar">
      <div class="header-badges-list">
        <span class="badge-chip purple"><%= note.subject %></span>
        <% if (note.topic) { %>
          <span class="badge-chip purple-soft"><%= note.topic %></span>
        <% } %>
        <span class="badge-chip muted">Sem <%= note.semester %></span>
        <span class="badge-chip uppercase"><%= (note.resourceType || 'PDF').toUpperCase() %></span>
        <% if (typeof avgRating !== 'undefined' && avgRating > 0) { %>
          <span class="badge-chip gold" id="headerRatingBadge">★ <%= avgRating %> (<%= totalRatings %>)</span>
        <% } %>
      </div>

      <% if (typeof isOwner !== 'undefined' && (isOwner || isAdmin)) { %>
        <div class="resource-detail-manage-actions">
          <a href="/notes/<%= note._id %>/edit" class="resource-detail-manage-btn resource-detail-edit-btn" aria-label="Edit resource <%= note.title %>">
            <span class="btn-icon">✏️</span>
            <span>Edit Resource</span>
          </a>
          <form action="/notes/<%= note._id %>?_method=DELETE" method="POST" class="resource-detail-delete-form" onsubmit="return confirm('Are you sure you want to delete this resource? This action cannot be undone.');">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <button type="submit" class="resource-detail-manage-btn resource-detail-delete-btn" aria-label="Delete resource <%= note.title %>">
              <span class="btn-icon">🗑️</span>
              <span>Delete Resource</span>
            </button>
          </form>
        </div>
      <% } %>
    </div>

    <!-- Resource Title -->
    <h1 class="resource-title"><%= note.title %></h1>

    <!-- Short Description -->
    <% if (note.description) { %>
      <p class="resource-short-desc"><%= note.description %></p>
    <% } %>

    <!-- Author & Timestamp -->
    <div class="resource-author-meta">
      <div class="author-info">
        <%- include('../partials/author_badge', { author: note.author }) %>
      </div>
      <div class="upload-date">
        <span>• Uploaded <%= new Date(note.createdAt).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
        <% if (note.updatedAt && new Date(note.updatedAt).getTime() - new Date(note.createdAt).getTime() > 86400000) { %>
          <span class="updated-subtext">(Updated <%= new Date(note.updatedAt).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }) %>)</span>
        <% } %>
      </div>
    </div>

    <!-- Divider -->
    <div class="header-divider"></div>

    <!-- Moderation Warning Banner -->
    <% if (note.approvalStatus && note.approvalStatus !== 'approved') { %>
      <div class="moderation-alert-banner">
        <span>🟡 <strong>Pending Moderation</strong> — Interactions disabled until Admin review.</span>
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
          <a href="/admin/pending-notes" class="action-btn action-btn-primary" style="padding: 6px 14px; font-size: 12px;">Review →</a>
        <% } %>
      </div>
    <% } else { %>
      <!-- Primary Actions Bar -->
      <div class="resource-actions-bar">
        <!-- Secondary Action Buttons (Like, Bookmark, Rate, Share) -->
        <div class="secondary-actions-group">
          <!-- Like Button -->
          <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
            <button type="button"
                    class="action-btn action-like <%= typeof isLiked !== 'undefined' && isLiked ? 'liked' : '' %>"
                    data-action="like"
                    data-note-id="<%= note._id %>"
                    data-liked="<%= typeof isLiked !== 'undefined' && isLiked ? 'true' : 'false' %>"
                    aria-label="<%= typeof isLiked !== 'undefined' && isLiked ? 'Unlike' : 'Like' %> this resource">
              <span class="action-icon like-icon" aria-hidden="true"><%= typeof isLiked !== 'undefined' && isLiked ? '❤️' : '🤍' %></span>
              <span class="like-label"><%= typeof isLiked !== 'undefined' && isLiked ? 'Liked' : 'Like' %></span>
              <span class="action-count" data-count><%= typeof likeCount !== 'undefined' ? likeCount : 0 %></span>
            </button>
          <% } else { %>
            <a href="/auth/login" class="action-btn action-like" aria-label="Log in to like">
              <span class="action-icon" aria-hidden="true">🤍</span>
              <span>Like</span>
              <span class="action-count"><%= typeof likeCount !== 'undefined' ? likeCount : 0 %></span>
            </a>
          <% } %>

          <!-- Bookmark / Save Button -->
          <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
            <button type="button"
                    class="action-btn action-bookmark <%= typeof isBookmarked !== 'undefined' && isBookmarked ? 'bookmarked' : '' %>"
                    data-action="bookmark"
                    data-note-id="<%= note._id %>"
                    data-bookmarked="<%= typeof isBookmarked !== 'undefined' && isBookmarked ? 'true' : 'false' %>"
                    aria-label="<%= typeof isBookmarked !== 'undefined' && isBookmarked ? 'Remove bookmark' : 'Save bookmark' %>">
              <span class="action-icon bookmark-icon" aria-hidden="true"><%= typeof isBookmarked !== 'undefined' && isBookmarked ? '🔖' : '📑' %></span>
              <span class="bookmark-label"><%= typeof isBookmarked !== 'undefined' && isBookmarked ? 'Saved' : 'Save' %></span>
            </button>
          <% } else { %>
            <a href="/auth/login" class="action-btn action-bookmark" aria-label="Log in to bookmark">
              <span class="action-icon" aria-hidden="true">📑</span>
              <span>Save</span>
            </a>
          <% } %>

          <!-- Rate Shortcut Button -->
          <a href="#rate-section" class="action-btn action-rate" aria-label="Rate this resource">
            <span class="action-icon" aria-hidden="true">⭐</span>
            <span>Rate</span>
          </a>

          <!-- Share Button -->
          <button type="button"
                  class="action-btn action-share"
                  id="shareBtn"
                  data-action="open-share"
                  aria-haspopup="dialog"
                  aria-label="Share this resource">
            <span class="action-icon" aria-hidden="true">↗</span>
            <span>Share</span>
          </button>
        </div>

        <!-- Primary Action (Download) -->
        <% if (note.fileUrl) { %>
          <div class="primary-action-group">
            <a href="/notes/<%= note._id %>/download?v=<%= note.fileVersion || Date.parse(note.updatedAt) %>"
               class="action-btn action-btn-primary action-download"
               id="downloadPrimaryBtn"
               title="<%= (typeof isAuthenticated !== 'undefined' && isAuthenticated) ? 'Download resource file' : 'Log in required to download' %>">
              <span class="action-icon" aria-hidden="true">⬇</span>
              <span>Download</span>
            </a>
          </div>
        <% } %>
      </div>
    <% } %>
  </header>

  <!-- Main Content Grid (Left Content ~70% / Right Sidebar ~30%) -->
  <div class="resource-main-grid">

    <!-- LEFT COLUMN: Document Preview, About, Discussion -->
    <div class="resource-primary-col">

      <!-- Document Preview Card -->
      <section class="content-card doc-preview-card" aria-label="Document Preview">
        <div class="card-header-bar">
          <h2 class="card-title">📄 Document Preview</h2>
        </div>

        <% if (note.fileUrl) { %>
          <!-- Responsive Centered Viewport -->
          <div class="doc-preview-viewport">
            <% if (note.mimeType && note.mimeType.includes('pdf')) { %>
              <iframe
                src="<%= note.fileUrl %><%= note.fileUrl.includes('?') ? '&' : '?' %>v=<%= note.fileVersion || Date.parse(note.updatedAt) %>#view=FitH&page=1"
                class="doc-preview-frame"
                id="docPreviewFrame"
                title="Document preview: <%= note.title %>"
                loading="lazy">
              </iframe>
              <div class="doc-preview-fallback" id="docPreviewFallback" style="display: none;" role="region" aria-label="Document preview fallback">
                <span class="fallback-icon" aria-hidden="true">📄</span>
                <strong class="fallback-title">Preview Unavailable</strong>
                <p class="fallback-desc">The embedded preview could not be displayed directly in your current browser.</p>
                <div class="fallback-actions">
                  <a href="/notes/<%= note._id %>/view?v=<%= note.fileVersion || Date.parse(note.updatedAt) %>"
                     target="_blank" rel="noopener noreferrer"
                     class="action-btn action-btn-secondary"
                     title="Open PDF in new tab">
                    <span aria-hidden="true">↗</span> Open in New Tab
                  </a>
                  <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
                    <a href="/notes/<%= note._id %>/download"
                       class="action-btn action-btn-primary"
                       title="Download document">
                      <span aria-hidden="true">⬇</span> Download Document
                    </a>
                  <% } else { %>
                    <a href="/auth/login?returnTo=<%= encodeURIComponent('/notes/' + note._id) %>"
                       class="action-btn action-btn-primary"
                       title="Log in to download document">
                      <span aria-hidden="true">🔒</span> Log In to Download
                    </a>
                  <% } %>
                </div>
              </div>
            <% } else if (note.mimeType && note.mimeType.includes('image')) { %>
              <img src="<%= note.fileUrl %><%= note.fileUrl.includes('?') ? '&' : '?' %>v=<%= note.fileVersion || Date.parse(note.updatedAt) %>"
                   alt="<%= note.title %>"
                   class="doc-preview-image">
            <% } else { %>
              <div class="doc-preview-placeholder">
                <span class="placeholder-icon" aria-hidden="true">📄</span>
                <strong class="placeholder-filename"><%= note.fileName || 'Attached Document' %></strong>
                <% if (note.fileSize) { %>
                  <span class="placeholder-filesize"><%= (note.fileSize / (1024*1024)).toFixed(2) %> MB</span>
                <% } %>
              </div>
            <% } %>
          </div>

          <!-- Document Controls & File Info -->
          <div class="doc-preview-footer">
            <button type="button"
                    class="action-btn action-btn-modal"
                    data-action="view-full-doc"
                    data-src="<%= note.fileUrl %><%= note.fileUrl.includes('?') ? '&' : '?' %>v=<%= note.fileVersion || Date.parse(note.updatedAt) %>"
                    aria-haspopup="dialog"
                    aria-label="View full document in modal">
              <span aria-hidden="true">⛶</span> View Full Document
            </button>
            <div class="file-info-badge">
              <span class="file-name-text"><%= note.fileName || 'Attached Document' %></span>
              <% if (note.fileSize) { %>
                <span class="file-size-text">• <%= (note.fileSize / (1024*1024)).toFixed(2) %> MB</span>
              <% } %>
              <a href="/notes/<%= note._id %>/view?v=<%= note.fileVersion || Date.parse(note.updatedAt) %>"
                 target="_blank" rel="noopener noreferrer"
                 class="open-tab-link"
                 title="Open PDF in new tab">↗ New Tab</a>
            </div>
          </div>
        <% } else { %>
          <div class="doc-preview-empty">
            <p>No attached document for this resource.</p>
          </div>
        <% } %>
      </section>

      <!-- About this Resource -->
      <section class="content-card resource-about-card" aria-label="About this resource">
        <h2 class="card-title">About this Resource</h2>
        
        <div class="resource-description-text">
          <%= note.content || note.description || 'No detailed description provided.' %>
        </div>

        <% if (note.topic) { %>
          <div class="about-key-topics">
            <h4 class="about-subsection-title">KEY TOPIC</h4>
            <p class="key-topic-text">• <%= note.topic %></p>
          </div>
        <% } %>

        <% if (note.tags && note.tags.length > 0) { %>
          <div class="resource-tags-section">
            <h4 class="about-subsection-title">TAGS</h4>
            <div class="tags-chips-list">
              <% note.tags.forEach(tag => { %>
                <a href="/notes?search=<%= encodeURIComponent(tag) %>" class="tag-chip">#<%= tag %></a>
              <% }) %>
            </div>
          </div>
        <% } %>
      </section>

      <!-- Discussion / Comments Section -->
      <section id="comments" class="content-card resource-discussion-card" aria-label="Discussion">
        <div class="discussion-header-bar">
          <h2 class="card-title">
            💬 Discussion
            <span class="comment-count-badge" id="commentCount"><%= typeof comments !== 'undefined' ? comments.length : 0 %></span>
          </h2>
        </div>

        <!-- Post Comment Form -->
        <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
          <form data-ajax-comment data-note-id="<%= note._id %>" action="/notes/<%= note._id %>/comments" method="POST" class="comment-post-form" autocomplete="off">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <div class="comment-textarea-wrap">
              <textarea name="content"
                        rows="3"
                        required
                        placeholder="Write a comment or ask a question..."
                        aria-label="Write a comment"
                        class="comment-textarea"></textarea>
            </div>
            <div class="comment-form-actions">
              <button type="submit" class="action-btn action-btn-primary comment-submit-btn">
                Post Comment
              </button>
            </div>
          </form>
        <% } else { %>
          <div class="comment-guest-prompt">
            <p>Have a question or feedback? <a href="/auth/login" class="login-prompt-link">Log in to join the discussion</a>.</p>
          </div>
        <% } %>

        <!-- Comments List -->
        <div class="comment-list" id="commentList">
          <% if (typeof comments !== 'undefined' && comments.length > 0) { %>
            <% comments.forEach(comment => { %>
              <div class="comment-item" id="comment-<%= comment._id %>">
                <div class="comment-header">
                  <div class="comment-author-row">
                    <div class="comment-avatar">
                      <% if (comment.user && comment.user.avatar && (comment.user.avatar.startsWith('/') || comment.user.avatar.startsWith('http'))) { %>
                        <img src="<%= comment.user.avatar %>" alt="<%= comment.user.name %>" class="comment-avatar-img">
                      <% } else { %>
                        <span class="comment-avatar-initial"><%= comment.user ? comment.user.name.charAt(0).toUpperCase() : 'U' %></span>
                      <% } %>
                    </div>
                    <div class="comment-author-meta">
                      <a href="/profile/<%= comment.user ? comment.user.username : '' %>" class="comment-user-name">
                        <%= comment.user ? comment.user.name : 'Anonymous' %>
                      </a>
                      <span class="comment-user-handle">@<%= comment.user ? comment.user.username : 'user' %></span>
                    </div>
                  </div>
                  <span class="comment-timestamp"><%= new Date(comment.createdAt).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
                </div>
                <p class="comment-text"><%= comment.content %></p>
                <% if (typeof currentUser !== 'undefined' && currentUser && (comment.user && (comment.user._id ? comment.user._id.toString() : comment.user.toString()) === currentUser._id.toString() || currentUser.role === 'admin')) { %>
                  <div class="comment-footer-actions">
                    <button type="button"
                            class="comment-delete-btn"
                            data-action="delete-comment"
                            data-comment-id="<%= comment._id %>"
                            aria-label="Delete comment">
                      🗑️ Delete
                    </button>
                  </div>
                <% } %>
              </div>
            <% }) %>
          <% } else { %>
            <div id="commentEmpty" class="comment-empty-wrap">
              <span class="empty-icon" aria-hidden="true">💬</span>
              <strong class="empty-title">No comments yet</strong>
              <p class="empty-sub">Be the first to start the discussion.</p>
            </div>
          <% } %>
        </div>
      </section>

    </div><!-- end left column -->

    <!-- RIGHT COLUMN (SIDEBAR): Resource Details & Rating -->
    <div class="resource-sidebar-col">

      <!-- Resource Details Card -->
      <aside class="content-card resource-info-card" aria-label="Resource Details">
        <h3 class="card-subtitle-caps">RESOURCE DETAILS</h3>
        
        <div class="metadata-grid">
          <% if (note.resourceType) { %>
            <div class="meta-item">
              <span class="meta-label"><span>📄</span> Type</span>
              <span class="meta-value uppercase-text"><%= note.resourceType.toUpperCase() %></span>
            </div>
          <% } %>

          <% if (note.subject) { %>
            <div class="meta-item">
              <span class="meta-label"><span>📚</span> Subject</span>
              <span class="meta-value"><%= note.subject %></span>
            </div>
          <% } %>

          <% if (note.topic) { %>
            <div class="meta-item">
              <span class="meta-label"><span>🏷</span> Topic</span>
              <span class="meta-value"><%= note.topic %></span>
            </div>
          <% } %>

          <% if (note.semester) { %>
            <div class="meta-item">
              <span class="meta-label"><span>🎓</span> Semester</span>
              <span class="meta-value"><%= note.semester %></span>
            </div>
          <% } %>

          <% const displayBranch = note.branch || (note.author && note.author.branch); %>
          <% if (displayBranch) { %>
            <div class="meta-item">
              <span class="meta-label"><span>💻</span> Branch</span>
              <span class="meta-value"><%= displayBranch %></span>
            </div>
          <% } %>

          <% const displayDept = note.department || (note.author && note.author.department); %>
          <% if (displayDept) { %>
            <div class="meta-item">
              <span class="meta-label"><span>🏫</span> Department</span>
              <span class="meta-value"><%= displayDept %></span>
            </div>
          <% } %>

          <% if (note.fileSize) { %>
            <div class="meta-item">
              <span class="meta-label"><span>💾</span> Size</span>
              <span class="meta-value"><%= (note.fileSize / (1024*1024)).toFixed(2) %> MB</span>
            </div>
          <% } %>

          <div class="meta-item">
            <span class="meta-label"><span>👁</span> Views</span>
            <span class="meta-value"><%= note.views || 0 %></span>
          </div>

          <div class="meta-item">
            <span class="meta-label"><span>⬇</span> Downloads</span>
            <span class="meta-value"><%= note.downloads || 0 %></span>
          </div>

          <% if (typeof avgRating !== 'undefined' && avgRating > 0) { %>
            <div class="meta-item">
              <span class="meta-label"><span>⭐</span> Rating</span>
              <span class="meta-value gold-text">★ <%= avgRating %></span>
            </div>
          <% } %>

          <% if (note.author) { %>
            <div class="meta-item full-span">
              <span class="meta-label"><span>👤</span> Uploaded By</span>
              <span class="meta-value">
                <a href="/profile/<%= note.author.username %>" class="author-meta-link"><%= note.author.name %></a>
              </span>
            </div>
          <% } %>

          <div class="meta-item full-span">
            <span class="meta-label"><span>📅</span> Uploaded</span>
            <span class="meta-value"><%= new Date(note.createdAt).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
          </div>

          <% if (note.visibility) { %>
            <div class="meta-item full-span">
              <span class="meta-label"><span>🔓</span> Visibility</span>
              <span class="meta-value green-text"><%= note.visibility.charAt(0).toUpperCase() + note.visibility.slice(1) %></span>
            </div>
          <% } %>
        </div>
      </aside>

      <!-- Rating Section -->
      <section id="rate-section" class="content-card resource-rating-card" aria-label="Rate this resource">
        <h3 class="card-subtitle-caps">⭐ RATE THIS RESOURCE</h3>
        
        <div class="rating-box-inner">
          <% if (typeof avgRating !== 'undefined' && avgRating > 0) { %>
            <div class="rating-display-header">
              <span class="rating-big-score" id="ratingSummaryAvg">★ <%= avgRating %></span>
              <span class="rating-count-label" id="ratingSummaryCount">Based on <%= totalRatings %> rating<%= totalRatings !== 1 ? 's' : '' %></span>
            </div>
          <% } else { %>
            <div class="rating-display-header">
              <span class="rating-subtext">No ratings yet. Be the first to rate!</span>
            </div>
          <% } %>

          <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
            <form data-ajax-rating data-note-id="<%= note._id %>" action="/notes/<%= note._id %>/rate" method="POST" class="rating-form" autocomplete="off">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              
              <div class="stars-interactive-group" role="radiogroup" aria-label="Rating out of 5 stars">
                <% [1, 2, 3, 4, 5].forEach(star => { %>
                  <label class="star-rating-item" title="<%= star %> star<%= star > 1 ? 's' : '' %>">
                    <input type="radio"
                           name="rating"
                           value="<%= star %>"
                           <%= typeof userRating !== 'undefined' && userRating === star ? 'checked' : '' %>
                           required
                           class="visually-hidden">
                    <span class="star-glyph <%= typeof userRating !== 'undefined' && userRating >= star ? 'selected' : '' %>"
                          data-star-val="<%= star %>"
                          aria-hidden="true">★</span>
                  </label>
                <% }) %>
              </div>

              <input type="text"
                     name="review"
                     placeholder="Optional review (e.g. 'Very clear formulas')..."
                     maxlength="200"
                     class="rating-review-input">

              <button type="submit" class="action-btn action-btn-primary full-width-btn rating-submit-btn">
                Submit Rating
              </button>
            </form>
          <% } else { %>
            <div class="rating-guest-box">
              <p class="guest-text">Login to rate and review this resource.</p>
              <a href="/auth/login" class="action-btn full-width-btn" style="justify-content: center;">
                Login to Rate
              </a>
            </div>
          <% } %>
        </div>
      </section>

    </div><!-- end right column -->

  </div><!-- end resource-main-grid -->

</div><!-- end page-container -->

<!-- Full Document Viewer Modal -->
<div id="docModalOverlay" class="doc-modal-overlay" role="dialog" aria-modal="true" aria-label="Full document viewer" style="display: none;">
  <div class="doc-modal-inner">
    <div class="doc-modal-header">
      <div class="doc-modal-title-wrap">
        <span class="doc-modal-icon" aria-hidden="true">📄</span>
        <span class="doc-modal-title"><%= note.title %></span>
      </div>
      <div class="doc-modal-actions">
        <a href="/notes/<%= note._id %>/view?v=<%= note.fileVersion || Date.parse(note.updatedAt) %>"
           target="_blank" rel="noopener noreferrer"
           class="modal-tool-btn"
           title="Open in new browser tab">↗ New Tab</a>
        <button type="button" id="docModalClose" class="modal-close-btn" aria-label="Close document viewer">✕</button>
      </div>
    </div>
    <iframe id="docModalFrame" class="doc-modal-frame" title="Full document: <%= note.title %>" src="" loading="lazy"></iframe>
  </div>
</div>

<!-- Share Resource Modal -->
<div id="shareModalOverlay" class="share-modal-overlay" role="dialog" aria-modal="true" aria-label="Share resource" style="display: none;">
  <div class="share-modal-card">
    <div class="share-modal-header">
      <h3 class="share-modal-title">↗ Share Resource</h3>
      <button type="button" id="shareModalClose" class="modal-close-btn" aria-label="Close share dialog">✕</button>
    </div>
    
    <p class="share-modal-desc">Share this academic resource with classmates or study groups:</p>

    <!-- Copy Link Bar -->
    <div class="share-copy-box">
      <input type="text"
             readonly
             id="shareUrlField"
             value="<%= typeof shareUrl !== 'undefined' ? shareUrl : '' %>"
             aria-label="Resource URL"
             class="share-url-input">
      <button type="button" id="copyShareUrlBtn" class="action-btn action-btn-primary copy-btn">
        <span id="copyBtnIcon" aria-hidden="true">🔗</span>
        <span id="copyBtnText">Copy Link</span>
      </button>
    </div>

    <!-- Social Share Buttons -->
    <div class="share-social-grid">
      <a href="<%= typeof whatsappShareUrl !== 'undefined' ? whatsappShareUrl : '#' %>"
         target="_blank" rel="noopener noreferrer"
         class="social-share-btn whatsapp"
         aria-label="Share via WhatsApp">
        <span class="social-icon" aria-hidden="true">🟢</span> WhatsApp
      </a>
      <a href="<%= typeof telegramShareUrl !== 'undefined' ? telegramShareUrl : '#' %>"
         target="_blank" rel="noopener noreferrer"
         class="social-share-btn telegram"
         aria-label="Share via Telegram">
        <span class="social-icon" aria-hidden="true">🔵</span> Telegram
      </a>
      <a href="<%= typeof linkedinShareUrl !== 'undefined' ? linkedinShareUrl : '#' %>"
         target="_blank" rel="noopener noreferrer"
         class="social-share-btn linkedin"
         aria-label="Share on LinkedIn">
        <span class="social-icon" aria-hidden="true">💼</span> LinkedIn
      </a>
      <a href="<%= typeof emailShareUrl !== 'undefined' ? emailShareUrl : '#' %>"
         class="social-share-btn email"
         aria-label="Share via Email">
        <span class="social-icon" aria-hidden="true">✉️</span> Email
      </a>
    </div>

    <!-- Native Web Share API Button (if supported) -->
    <div id="nativeShareWrap" style="display: none; margin-top: 14px;">
      <button type="button" id="nativeShareBtn" class="action-btn full-width-btn native-share-btn">
        <span aria-hidden="true">📱</span> Share via Device...
      </button>
    </div>
  </div>
</div>
