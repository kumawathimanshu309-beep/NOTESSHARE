<div class="page-container notes-page-container">
  
  <!-- Page Header -->
  <div class="page-header notes-page-header">
    <div class="section-badge">ACADEMIC RESOURCES</div>
    <h1 class="notes-page-title">Explore <span class="gradient-text">Study Notes & PYQs</span></h1>
    <p class="notes-page-subtitle">Discover high-quality lecture notes, previous year question papers (PYQs), and semester important questions shared by students and teachers.</p>
  </div>

  <!-- Resource Type Quick Filter Tabs -->
  <div class="notes-category-tabs">
    <a href="/notes" class="category-tab <%= typeof query === 'undefined' || !query.resourceType ? 'active' : '' %>" aria-label="Show all resources">
      <span class="tab-icon" aria-hidden="true">📚</span>
      <span class="tab-text">All Resources</span>
    </a>
    <a href="/notes?resourceType=pdf" class="category-tab <%= typeof query !== 'undefined' && query.resourceType === 'pdf' ? 'active' : '' %>" aria-label="Filter by study notes">
      <span class="tab-icon" aria-hidden="true">📄</span>
      <span class="tab-text">Study Notes</span>
    </a>
    <a href="/notes?resourceType=pyq" class="category-tab <%= typeof query !== 'undefined' && query.resourceType === 'pyq' ? 'active' : '' %>" aria-label="Filter by previous year papers">
      <span class="tab-icon" aria-hidden="true">📝</span>
      <span class="tab-text tab-text-desktop">Previous Year Papers (PYQ)</span>
      <span class="tab-text tab-text-mobile">PYQs</span>
    </a>
    <a href="/notes?resourceType=important_questions" class="category-tab <%= typeof query !== 'undefined' && query.resourceType === 'important_questions' ? 'active' : '' %>" aria-label="Filter by important questions">
      <span class="tab-icon" aria-hidden="true">🔥</span>
      <span class="tab-text">Important Questions</span>
    </a>
  </div>

  <!-- Search & Filter Controls Bar -->
  <div class="content-card notes-filter-card">
    <form action="/notes" method="GET" class="notes-filter-form">
      
      <!-- Hidden Resource Type if active -->
      <% if (typeof query !== 'undefined' && query.resourceType) { %>
        <input type="hidden" name="resourceType" value="<%= query.resourceType %>">
      <% } %>

      <!-- Search Input -->
      <div class="filter-field filter-field-search">
        <input 
          type="text" 
          name="search" 
          value="<%= typeof query !== 'undefined' && query.search ? query.search : '' %>" 
          placeholder="⌕ Search by title, subject, tags..." 
          aria-label="Search study notes by title, subject, or tags"
          class="filter-input"
        >
      </div>

      <!-- Subject Filter -->
      <div class="filter-field">
        <select name="subject" aria-label="Filter notes by subject" class="filter-select">
          <option value="all">All Subjects</option>
          <option value="Computer Science" <%= typeof query !== 'undefined' && query.subject === 'Computer Science' ? 'selected' : '' %>>Computer Science</option>
          <option value="Mathematics" <%= typeof query !== 'undefined' && query.subject === 'Mathematics' ? 'selected' : '' %>>Mathematics</option>
          <option value="Science" <%= typeof query !== 'undefined' && query.subject === 'Science' ? 'selected' : '' %>>Science</option>
          <option value="Engineering" <%= typeof query !== 'undefined' && query.subject === 'Engineering' ? 'selected' : '' %>>Engineering</option>
          <option value="General" <%= typeof query !== 'undefined' && query.subject === 'General' ? 'selected' : '' %>>General</option>
        </select>
      </div>

      <!-- Semester Filter -->
      <div class="filter-field">
        <select name="semester" aria-label="Filter notes by semester" class="filter-select">
          <option value="">All Semesters</option>
          <% for(let s = 1; s <= 8; s++) { %>
            <option value="<%= s %>" <%= typeof query !== 'undefined' && query.semester == s ? 'selected' : '' %>>Semester <%= s %></option>
          <% } %>
        </select>
      </div>

      <!-- Resource Type Filter -->
      <div class="filter-field">
        <select name="resourceType" aria-label="Filter notes by resource type" class="filter-select">
          <option value="">All Resource Types</option>
          <option value="pdf" <%= typeof query !== 'undefined' && query.resourceType === 'pdf' ? 'selected' : '' %>>Study Notes (PDF)</option>
          <option value="pyq" <%= typeof query !== 'undefined' && query.resourceType === 'pyq' ? 'selected' : '' %>>PYQ Question Papers</option>
          <option value="important_questions" <%= typeof query !== 'undefined' && query.resourceType === 'important_questions' ? 'selected' : '' %>>Important Questions</option>
        </select>
      </div>

      <!-- Sort By -->
      <div class="filter-field">
        <select name="sort" aria-label="Sort notes list" class="filter-select">
          <option value="newest" <%= typeof query !== 'undefined' && query.sort === 'newest' ? 'selected' : '' %>>Newest First</option>
          <option value="oldest" <%= typeof query !== 'undefined' && query.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
          <option value="popular" <%= typeof query !== 'undefined' && query.sort === 'popular' ? 'selected' : '' %>>Most Viewed</option>
          <option value="downloads" <%= typeof query !== 'undefined' && query.sort === 'downloads' ? 'selected' : '' %>>Most Downloaded</option>
        </select>
      </div>

      <!-- Submit Button -->
      <div class="filter-field filter-field-btn">
        <button type="submit" class="primary-button filter-submit-btn" aria-label="Filter results">
          Filter
        </button>
      </div>

    </form>
  </div>

  <!-- Note Card Grid -->
  <div class="notes-cards-grid">
    <% if (typeof notes !== 'undefined' && notes && notes.length > 0) { %>
      <% notes.forEach(note => { %>
        <div class="feature-card note-card-item">
          
          <div class="note-card-header">
            <% if (note.resourceType === 'pyq') { %>
              <span class="note-type-chip chip-pyq">
                📝 PYQ <%= note.year ? note.year : '' %> • Sem <%= note.semester %>
              </span>
            <% } else if (note.resourceType === 'important_questions') { %>
              <span class="note-type-chip chip-important">
                🔥 Important Qs • Sem <%= note.semester %>
              </span>
            <% } else { %>
              <span class="note-type-chip chip-notes">
                <%= note.subject %> • Sem <%= note.semester %>
              </span>
            <% } %>

            <span class="note-stats-text">
              👁️ <%= note.views || 0 %> | 📥 <%= note.downloads || 0 %>
            </span>
          </div>

          <h2 class="note-card-title">
            <a href="/notes/<%= note._id %>">
              <%= note.title %>
            </a>
          </h2>

          <p class="note-card-desc">
            <%= note.description ? (note.description.length > 110 ? note.description.substring(0, 110) + '...' : note.description) : 'No description provided.' %>
          </p>


          <div class="note-card-footer">
            <%- include('../partials/author_badge', { author: note.author }) %>

            <a href="/notes/<%= note._id %>" class="note-view-link" aria-label="View resource <%= note.title %>">
              View Resource →
            </a>
          </div>

        </div>
      <% }) %>
    <% } else { %>
      <div class="content-card notes-empty-card">
        <div class="empty-icon" aria-hidden="true">🔍</div>
        <h3 class="empty-title">No Academic Resources Found</h3>
        <p class="empty-desc">Try adjusting your search keywords or active subject/semester/resource-type filters.</p>
        <a href="/notes" class="secondary-button empty-reset-btn">Reset Filters</a>
      </div>
    <% } %>
  </div>

  <!-- Pagination Controls -->
  <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
    <div class="notes-pagination-bar">
      <% if (page > 1) { %>
        <a href="/notes?page=<%= page - 1 %>&search=<%= query.search || '' %>&subject=<%= query.subject || '' %>&semester=<%= query.semester || '' %>&resourceType=<%= query.resourceType || '' %>&sort=<%= query.sort || '' %>" class="secondary-button pagination-btn">← Previous</a>
      <% } %>

      <span class="pagination-info">Page <%= page %> of <%= totalPages %></span>

      <% if (page < totalPages) { %>
        <a href="/notes?page=<%= page + 1 %>&search=<%= query.search || '' %>&subject=<%= query.subject || '' %>&semester=<%= query.semester || '' %>&resourceType=<%= query.resourceType || '' %>&sort=<%= query.sort || '' %>" class="secondary-button pagination-btn">Next →</a>
      <% } %>
    </div>
  <% } %>

</div>
