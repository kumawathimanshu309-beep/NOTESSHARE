<div class="page-container" style="max-width: 720px;">
  
  <div class="page-header" style="text-align: left; margin-bottom: 30px;">
    <div class="section-badge">SHARE KNOWLEDGE</div>
    <h1>Upload & Share <span class="gradient-text">Study Note</span></h1>
    <p>Upload your lecture notes, slides, or past paper solutions to help students succeed.</p>
  </div>

  <div class="content-card" style="padding: 40px; border-radius: 20px;">
    <form action="/notes" method="POST" enctype="multipart/form-data">
      
      <!-- Title -->
      <div style="margin-bottom: 22px;">
        <label for="title" style="display: block; font-size: 12px; font-weight: 600; color: var(--text); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">Note Title *</label>
        <input 
          type="text" 
          id="title" 
          name="title" 
          value="<%= typeof formData !== 'undefined' && formData.title ? formData.title : '' %>"
          placeholder="e.g. Database Management Systems Complete Unit 1-5 Notes"
          required
          style="width: 100%; padding: 13px 16px; border-radius: 10px; border: 1px solid var(--border); background: rgba(255,255,255,0.03); color: white; font-size: 14px; outline: none;"
          onfocus="this.style.borderColor='var(--violet)'"
          onblur="this.style.borderColor='var(--border)'"
        >
      </div>

      <!-- Grid for Field, Branch, Semester, Subject, Resource Type -->
      <div class="form-grid-2col" style="margin-bottom: 20px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px;">
        
        <!-- Field -->
        <div>
          <label for="field" style="display: block; font-size: 11px; font-weight: 600; color: var(--text); margin-bottom: 6px; text-transform: uppercase;">Field *</label>
          <select id="field" name="field" required style="width: 100%; padding: 12px; border-radius: 9px; border: 1px solid var(--border); background: #0D1124; color: white; font-size: 13px; outline: none;">
            <% if (typeof fields !== 'undefined' && fields && fields.length > 0) { %>
              <% fields.forEach(f => { %>
                <option value="<%= f %>" <%= (typeof defaultField !== 'undefined' && defaultField === f) ? 'selected' : '' %>><%= f %></option>
              <% }) %>
            <% } else { %>
              <option value="Engineering" selected>Engineering</option>
            <% } %>
          </select>
        </div>

        <!-- Branch -->
        <div>
          <label for="branch" style="display: block; font-size: 11px; font-weight: 600; color: var(--text); margin-bottom: 6px; text-transform: uppercase;">Branch *</label>
          <select id="branch" name="branch" required style="width: 100%; padding: 12px; border-radius: 9px; border: 1px solid var(--border); background: #0D1124; color: white; font-size: 13px; outline: none;">
            <option value="">Select Branch</option>
            <% if (typeof branches !== 'undefined' && branches && branches.length > 0) { %>
              <% branches.forEach(b => { %>
                <option value="<%= b %>" <%= (typeof defaultBranch !== 'undefined' && defaultBranch === b) ? 'selected' : '' %>><%= b %></option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <!-- Semester -->
        <div>
          <label for="semester" style="display: block; font-size: 11px; font-weight: 600; color: var(--text); margin-bottom: 6px; text-transform: uppercase;">Semester *</label>
          <select id="semester" name="semester" required style="width: 100%; padding: 12px; border-radius: 9px; border: 1px solid var(--border); background: #0D1124; color: white; font-size: 13px; outline: none;">
            <% for(let s = 1; s <= 8; s++) { %>
              <option value="<%= s %>" <%= (typeof defaultSemester !== 'undefined' && defaultSemester == s) ? 'selected' : '' %>>Semester <%= s %></option>
            <% } %>
          </select>
        </div>

        <!-- Subject -->
        <div>
          <label for="subject" style="display: block; font-size: 11px; font-weight: 600; color: var(--text); margin-bottom: 6px; text-transform: uppercase;">Subject *</label>
          <select id="subject" name="subject" required style="width: 100%; padding: 12px; border-radius: 9px; border: 1px solid var(--border); background: #0D1124; color: white; font-size: 13px; outline: none;">
            <option value="">Select Branch First</option>
            <% if (typeof activeSubjects !== 'undefined' && activeSubjects && activeSubjects.length > 0) { %>
              <% activeSubjects.forEach(s => { %>
                <option value="<%= s.name %>" data-id="<%= s._id %>" data-branch="<%= s.department %>" <%= (typeof defaultSubject !== 'undefined' && defaultSubject === s.name) ? 'selected' : '' %>><%= s.name %> <%= s.code ? '(' + s.code + ')' : '' %></option>
              <% }) %>
            <% } %>
          </select>
          <input type="hidden" id="subjectId" name="subjectId" value="">
        </div>

        <!-- Resource Type (Spans 2 columns on desktop so layout adjusts cleanly with no empty gap) -->
        <div style="grid-column: 1 / -1;">
          <label for="resourceType" style="display: block; font-size: 11px; font-weight: 600; color: var(--text); margin-bottom: 6px; text-transform: uppercase;">Resource Type *</label>
          <select id="resourceType" name="resourceType" required style="width: 100%; padding: 12px; border-radius: 9px; border: 1px solid var(--border); background: #0D1124; color: white; font-size: 13px; outline: none;">
            <option value="pdf" <%= (typeof defaultResourceType !== 'undefined' && defaultResourceType === 'pdf') ? 'selected' : '' %>>📄 Study Notes (PDF)</option>
            <option value="pyq" <%= (typeof defaultResourceType !== 'undefined' && defaultResourceType === 'pyq') ? 'selected' : '' %>>📝 Previous Year Paper (PYQ)</option>
            <option value="important_questions" <%= (typeof defaultResourceType !== 'undefined' && defaultResourceType === 'important_questions') ? 'selected' : '' %>>🔥 Important Questions</option>
            <option value="ppt" <%= (typeof defaultResourceType !== 'undefined' && defaultResourceType === 'ppt') ? 'selected' : '' %>>📊 PPT / Presentation</option>
            <option value="image" <%= (typeof defaultResourceType !== 'undefined' && defaultResourceType === 'image') ? 'selected' : '' %>>🖼️ Image Note</option>
            <option value="document" <%= (typeof defaultResourceType !== 'undefined' && defaultResourceType === 'document') ? 'selected' : '' %>>📁 Other Document</option>
            <option value="video" <%= (typeof defaultResourceType !== 'undefined' && defaultResourceType === 'video') ? 'selected' : '' %>>🎥 Video Reference</option>
          </select>
        </div>

      </div>

      <!-- File Attachment Picker -->
      <div style="margin-bottom: 22px; padding: 25px; border: 2px dashed rgba(168,85,247,0.3); border-radius: 14px; background: rgba(124,58,237,0.04); text-align: center;">
        <div style="font-size: 32px; margin-bottom: 10px;">📄</div>
        <label for="file" style="display: block; font-size: 14px; font-weight: 600; color: var(--lavender); margin-bottom: 6px; cursor: pointer;">
          Choose PDF / Document File to Upload
        </label>
        <p style="color: var(--muted); font-size: 12px; margin-bottom: 15px;">Supported formats: PDF, PPT, PPTX, JPG, PNG, WEBP (Max 15 MB)</p>
        
        <input 
          type="file" 
          id="file" 
          name="file" 
          accept=".pdf,.ppt,.pptx,.jpg,.jpeg,.png,.webp" 
          style="display: inline-block; font-size: 12px; color: var(--muted);"
        >
      </div>

      <!-- Description -->
      <div style="margin-bottom: 22px;">
        <label for="description" style="display: block; font-size: 12px; font-weight: 600; color: var(--text); margin-bottom: 8px; text-transform: uppercase;">Description Summary</label>
        <textarea 
          id="description" 
          name="description" 
          rows="3" 
          placeholder="Provide a brief summary of what topics this study note covers..." 
          style="width: 100%; padding: 13px 16px; border-radius: 10px; border: 1px solid var(--border); background: rgba(255,255,255,0.03); color: white; font-size: 14px; outline: none; font-family: inherit;"
          onfocus="this.style.borderColor='var(--violet)'"
          onblur="this.style.borderColor='var(--border)'"
        ></textarea>
      </div>

      <!-- Content Text -->
      <div style="margin-bottom: 22px;">
        <label for="content" style="display: block; font-size: 12px; font-weight: 600; color: var(--text); margin-bottom: 8px; text-transform: uppercase;">Detailed Text Content (Optional)</label>
        <textarea 
          id="content" 
          name="content" 
          rows="5" 
          placeholder="You can also write or paste written study notes, key formulas, or explanation text here..." 
          style="width: 100%; padding: 13px 16px; border-radius: 10px; border: 1px solid var(--border); background: rgba(255,255,255,0.03); color: white; font-size: 14px; outline: none; font-family: inherit;"
          onfocus="this.style.borderColor='var(--violet)'"
          onblur="this.style.borderColor='var(--border)'"
        ></textarea>
      </div>

      <!-- Grid for Tags, Visibility -->
      <div class="form-grid-2col">
        <div>
          <label for="tags" style="display: block; font-size: 11px; font-weight: 600; color: var(--text); margin-bottom: 6px; text-transform: uppercase;">Tags (Comma separated)</label>
          <input 
            type="text" 
            id="tags" 
            name="tags" 
            placeholder="e.g. algorithms, c++, trees, graphs" 
            style="width: 100%; padding: 12px; border-radius: 9px; border: 1px solid var(--border); background: rgba(255,255,255,0.03); color: white; font-size: 13px; outline: none;"
          >
        </div>

        <div>
          <label for="visibility" style="display: block; font-size: 11px; font-weight: 600; color: var(--text); margin-bottom: 6px; text-transform: uppercase;">Visibility</label>
          <select id="visibility" name="visibility" style="width: 100%; padding: 12px; border-radius: 9px; border: 1px solid var(--border); background: #0D1124; color: white; font-size: 13px; outline: none;">
            <option value="public">Public (Everyone)</option>
            <option value="private">Private (Only Me)</option>
          </select>
        </div>
      </div>

      <!-- Submit Buttons -->
      <div style="display: flex; gap: 15px;">
        <button type="submit" class="primary-button" style="flex: 1; padding: 14px; justify-content: center; font-size: 14px;">
          Publish & Share Note <span>→</span>
        </button>
        <a href="/notes" class="secondary-button" style="padding: 14px 25px;">Cancel</a>
      </div>

    </form>
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const fieldSelect = document.getElementById('field');
    const branchSelect = document.getElementById('branch');
    const subjectSelect = document.getElementById('subject');
    const subjectIdInput = document.getElementById('subjectId');

    const initialSubject = '<%= typeof defaultSubject !== "undefined" ? defaultSubject : "" %>';

    // 1. Load subjects by branch
    async function loadSubjects(branchName, targetSubjectName) {
      if (!subjectSelect) return;
      if (!branchName) {
        subjectSelect.innerHTML = '<option value="">Select Branch First</option>';
        if (subjectIdInput) subjectIdInput.value = '';
        return;
      }

      subjectSelect.innerHTML = '<option value="">Loading subjects...</option>';
      if (subjectIdInput) subjectIdInput.value = '';

      try {
        const res = await fetch('/api/subjects?branch=' + encodeURIComponent(branchName));
        const data = await res.json();
        if (data.success && Array.isArray(data.subjects) && data.subjects.length > 0) {
          subjectSelect.innerHTML = '<option value="">Select Subject</option>';
          let matchedOpt = null;
          data.subjects.forEach(s => {
            const opt = document.createElement('option');
            opt.value = s.name;
            opt.textContent = s.name + (s.code ? ' (' + s.code + ')' : '');
            opt.setAttribute('data-id', s._id);
            opt.setAttribute('data-branch', s.department || '');
            if (targetSubjectName && s.name.toLowerCase() === targetSubjectName.toLowerCase()) {
              opt.selected = true;
              matchedOpt = opt;
            }
            subjectSelect.appendChild(opt);
          });

          if (matchedOpt && subjectIdInput) {
            subjectIdInput.value = matchedOpt.getAttribute('data-id');
          }
        } else {
          subjectSelect.innerHTML = '<option value="">No subjects available for this branch.</option>';
        }
      } catch (err) {
        console.error('Error fetching subjects:', err);
        subjectSelect.innerHTML = '<option value="">Unable to load academic data. Please try again.</option>';
      }
    }

    // Event: Field changes -> reset branch and subject
    if (fieldSelect) {
      fieldSelect.addEventListener('change', function() {
        if (branchSelect) branchSelect.value = '';
        if (subjectSelect) subjectSelect.innerHTML = '<option value="">Select Branch First</option>';
        if (subjectIdInput) subjectIdInput.value = '';
      });
    }

    // Event: Branch changes -> load subjects
    if (branchSelect) {
      branchSelect.addEventListener('change', function() {
        loadSubjects(this.value, '');
      });
    }

    // Event: Subject changes -> set subjectId
    if (subjectSelect) {
      subjectSelect.addEventListener('change', function() {
        const selectedOpt = this.options[this.selectedIndex];
        const subjectId = selectedOpt ? selectedOpt.getAttribute('data-id') : null;
        if (subjectIdInput) subjectIdInput.value = subjectId || '';
      });
    }

    // Initialization on page load
    if (branchSelect && branchSelect.value) {
      loadSubjects(branchSelect.value, initialSubject);
    } else if (subjectSelect) {
      const selectedOpt = subjectSelect.options[subjectSelect.selectedIndex];
      if (selectedOpt && selectedOpt.value) {
        const subjectId = selectedOpt.getAttribute('data-id');
        if (subjectIdInput) subjectIdInput.value = subjectId || '';
      }
    }
  });
</script>
