<div class="page-container" style="max-width: 720px;">
  
  <div class="page-header" style="text-align: left; margin-bottom: 30px;">
    <div class="section-badge">SHARE KNOWLEDGE</div>
    <h1>Upload & Share <span class="gradient-text">Study Note</span></h1>
    <p>Upload your lecture notes, slides, or past paper solutions to help students succeed.</p>
  </div>

  <div class="content-card" style="padding: 40px; border-radius: 20px;">
    <form action="/notes" method="POST" id="newNoteForm" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      
      <!-- Title -->
      <div style="margin-bottom: 22px;">
        <label for="title" style="display: block; font-size: 12px; font-weight: 600; color: var(--text); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">Note Title *</label>
        <input 
          type="text" 
          id="title" 
          name="title" 
          value="<%= typeof formData !== 'undefined' && formData.title ? formData.title : '' %>"
          placeholder="e.g. Database Management Systems Complete Unit 1-5 Notes"
          required
          style="width: 100%; padding: 13px 16px; border-radius: 10px; border: 1px solid var(--border); background: rgba(255,255,255,0.03); color: white; font-size: 14px; outline: none;"
          onfocus="this.style.borderColor='var(--violet)'"
          onblur="this.style.borderColor='var(--border)'"
        >
      </div>

      <!-- Grid for Field, Branch, Semester, Subject, Resource Type -->
      <div class="form-grid-2col" style="margin-bottom: 20px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; position: relative; overflow: visible;">
        
        <!-- Field -->
        <div style="min-width: 0; position: relative; overflow: visible;">
          <label for="field" style="display: block; font-size: 11px; font-weight: 600; color: var(--text); margin-bottom: 6px; text-transform: uppercase;">Field *</label>
          <select id="field" name="field" class="filter-select" required style="width: 100%; height: 44px; padding: 0 32px 0 14px; border-radius: 9px; border: 1px solid var(--border); background: #0D1124; color: #FFFFFF; font-size: 13px; outline: none; cursor: pointer; color-scheme: dark; box-sizing: border-box;">
            <% if (typeof fields !== 'undefined' && fields && fields.length > 0) { %>
              <% fields.forEach(f => { %>
                <option value="<%= f %>" <%= (typeof defaultField !== 'undefined' && defaultField === f) ? 'selected' : '' %> style="background-color: #0D1124; color: #FFFFFF;"><%= f %></option>
              <% }) %>
            <% } else { %>
              <option value="Engineering" selected style="background-color: #0D1124; color: #FFFFFF;">Engineering</option>
            <% } %>
          </select>
        </div>

        <!-- Branch -->
        <div style="min-width: 0; position: relative; overflow: visible;">
          <label for="branch" style="display: block; font-size: 11px; font-weight: 600; color: var(--text); margin-bottom: 6px; text-transform: uppercase;">Branch *</label>
          <select id="branch" name="branch" class="filter-select" required style="width: 100%; height: 44px; padding: 0 32px 0 14px; border-radius: 9px; border: 1px solid var(--border); background: #0D1124; color: #FFFFFF; font-size: 13px; outline: none; cursor: pointer; color-scheme: dark; box-sizing: border-box;">
            <option value="" style="background-color: #0D1124; color: #FFFFFF;">Select Branch</option>
            <% if (typeof branches !== 'undefined' && branches && branches.length > 0) { %>
              <% branches.forEach(b => { %>
                <option value="<%= b %>" <%= (typeof defaultBranch !== 'undefined' && defaultBranch === b) ? 'selected' : '' %> style="background-color: #0D1124; color: #FFFFFF;"><%= b %></option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <!-- Semester -->
        <div style="min-width: 0; position: relative; overflow: visible;">
          <label for="semester" style="display: block; font-size: 11px; font-weight: 600; color: var(--text); margin-bottom: 6px; text-transform: uppercase;">Semester *</label>
          <select id="semester" name="semester" class="filter-select" required style="width: 100%; height: 44px; padding: 0 32px 0 14px; border-radius: 9px; border: 1px solid var(--border); background: #0D1124; color: #FFFFFF; font-size: 13px; outline: none; cursor: pointer; color-scheme: dark; box-sizing: border-box;">
            <% for(let s = 1; s <= 8; s++) { %>
              <option value="<%= s %>" <%= (typeof defaultSemester !== 'undefined' && defaultSemester == s) ? 'selected' : '' %> style="background-color: #0D1124; color: #FFFFFF;">Semester <%= s %></option>
            <% } %>
          </select>
        </div>

        <!-- Subject -->
        <div style="min-width: 0; position: relative; overflow: visible;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <label for="subject" style="font-size: 11px; font-weight: 600; color: var(--text); text-transform: uppercase;">Subject *</label>
            <span id="subjectStatusText" style="display: none; font-size: 11px; color: var(--lavender);">Loading...</span>
          </div>
          <select id="subject" name="subject" class="filter-select" required style="width: 100%; height: 44px; padding: 0 32px 0 14px; border-radius: 9px; border: 1px solid var(--border); background: #0D1124; color: #FFFFFF; font-size: 13px; outline: none; cursor: pointer; color-scheme: dark; box-sizing: border-box;" <%= (!defaultBranch) ? 'disabled' : '' %>>
            <option value="" style="background-color: #0D1124; color: #FFFFFF;"><%= defaultBranch ? 'Select Subject' : 'Select Branch First' %></option>
            <% if (defaultBranch && typeof activeSubjects !== 'undefined' && activeSubjects && activeSubjects.length > 0) { %>
              <% activeSubjects.filter(s => !s.department || s.department.toLowerCase() === defaultBranch.toLowerCase()).forEach(s => { %>
                <option value="<%= s.name %>" data-id="<%= s._id %>" data-branch="<%= s.department %>" <%= (typeof defaultSubject !== 'undefined' && defaultSubject === s.name) ? 'selected' : '' %> style="background-color: #0D1124; color: #FFFFFF;"><%= s.name %> <%= s.code ? '(' + s.code + ')' : '' %></option>
              <% }) %>
            <% } %>
          </select>
          <input type="hidden" id="subjectId" name="subjectId" value="<%= typeof defaultSubject !== 'undefined' && typeof activeSubjects !== 'undefined' ? (activeSubjects.find(s => s.name === defaultSubject)?._id || '') : '' %>">
        </div>

        <!-- Resource Type (Spans 2 columns on desktop so layout adjusts cleanly with no empty gap) -->
        <div style="grid-column: 1 / -1; min-width: 0; position: relative; overflow: visible;">
          <label for="resourceType" style="display: block; font-size: 11px; font-weight: 600; color: var(--text); margin-bottom: 6px; text-transform: uppercase;">Resource Type *</label>
          <select id="resourceType" name="resourceType" class="filter-select" required style="width: 100%; height: 44px; padding: 0 32px 0 14px; border-radius: 9px; border: 1px solid var(--border); background: #0D1124; color: #FFFFFF; font-size: 13px; outline: none; cursor: pointer; color-scheme: dark; box-sizing: border-box;">
            <option value="pdf" <%= (typeof defaultResourceType !== 'undefined' && defaultResourceType === 'pdf') ? 'selected' : '' %> style="background-color: #0D1124; color: #FFFFFF;">📄 Study Notes (PDF)</option>
            <option value="pyq" <%= (typeof defaultResourceType !== 'undefined' && defaultResourceType === 'pyq') ? 'selected' : '' %> style="background-color: #0D1124; color: #FFFFFF;">📝 Previous Year Paper (PYQ)</option>
            <option value="important_questions" <%= (typeof defaultResourceType !== 'undefined' && defaultResourceType === 'important_questions') ? 'selected' : '' %> style="background-color: #0D1124; color: #FFFFFF;">🔥 Important Questions</option>
            <option value="ppt" <%= (typeof defaultResourceType !== 'undefined' && defaultResourceType === 'ppt') ? 'selected' : '' %> style="background-color: #0D1124; color: #FFFFFF;">📊 PPT / Presentation</option>
            <option value="image" <%= (typeof defaultResourceType !== 'undefined' && defaultResourceType === 'image') ? 'selected' : '' %> style="background-color: #0D1124; color: #FFFFFF;">🖼️ Image Note</option>
            <option value="document" <%= (typeof defaultResourceType !== 'undefined' && defaultResourceType === 'document') ? 'selected' : '' %> style="background-color: #0D1124; color: #FFFFFF;">📁 Other Document</option>
            <option value="video" <%= (typeof defaultResourceType !== 'undefined' && defaultResourceType === 'video') ? 'selected' : '' %> style="background-color: #0D1124; color: #FFFFFF;">🎥 Video Reference</option>
          </select>
        </div>

      </div>

      <!-- File Attachment Picker -->
      <div style="margin-bottom: 22px; padding: 25px; border: 2px dashed rgba(168,85,247,0.3); border-radius: 14px; background: rgba(124,58,237,0.04); text-align: center;">
        <div style="font-size: 32px; margin-bottom: 10px;">📄</div>
        <label for="file" style="display: block; font-size: 14px; font-weight: 600; color: var(--lavender); margin-bottom: 6px; cursor: pointer;">
          Choose PDF / Document File to Upload
        </label>
        <p style="color: var(--muted); font-size: 12px; margin-bottom: 15px;">Supported formats: PDF, PPT, PPTX, JPG, PNG, WEBP (Max 15 MB)</p>
        
        <input 
          type="file" 
          id="file" 
          name="file" 
          accept=".pdf,.ppt,.pptx,.jpg,.jpeg,.png,.webp" 
          style="display: inline-block; font-size: 12px; color: var(--muted);"
        >
      </div>

      <!-- Description -->
      <div style="margin-bottom: 22px;">
        <label for="description" style="display: block; font-size: 12px; font-weight: 600; color: var(--text); margin-bottom: 8px; text-transform: uppercase;">Description Summary</label>
        <textarea 
          id="description" 
          name="description" 
          rows="3" 
          placeholder="Provide a brief summary of what topics this study note covers..." 
          style="width: 100%; padding: 13px 16px; border-radius: 10px; border: 1px solid var(--border); background: rgba(255,255,255,0.03); color: white; font-size: 14px; outline: none; font-family: inherit;"
          onfocus="this.style.borderColor='var(--violet)'"
          onblur="this.style.borderColor='var(--border)'"
        ></textarea>
      </div>

      <!-- Content Text -->
      <div style="margin-bottom: 22px;">
        <label for="content" style="display: block; font-size: 12px; font-weight: 600; color: var(--text); margin-bottom: 8px; text-transform: uppercase;">Detailed Text Content (Optional)</label>
        <textarea 
          id="content" 
          name="content" 
          rows="5" 
          placeholder="You can also write or paste written study notes, key formulas, or explanation text here..." 
          style="width: 100%; padding: 13px 16px; border-radius: 10px; border: 1px solid var(--border); background: rgba(255,255,255,0.03); color: white; font-size: 14px; outline: none; font-family: inherit;"
          onfocus="this.style.borderColor='var(--violet)'"
          onblur="this.style.borderColor='var(--border)'"
        ></textarea>
      </div>

      <!-- Grid for Tags, Visibility -->
      <div class="form-grid-2col">
        <div>
          <label for="tags" style="display: block; font-size: 11px; font-weight: 600; color: var(--text); margin-bottom: 6px; text-transform: uppercase;">Tags (Comma separated)</label>
          <input 
            type="text" 
            id="tags" 
            name="tags" 
            placeholder="e.g. algorithms, c++, trees, graphs" 
            style="width: 100%; padding: 12px; border-radius: 9px; border: 1px solid var(--border); background: rgba(255,255,255,0.03); color: white; font-size: 13px; outline: none;"
          >
        </div>

        <div>
          <label for="visibility" style="display: block; font-size: 11px; font-weight: 600; color: var(--text); margin-bottom: 6px; text-transform: uppercase;">Visibility</label>
          <select id="visibility" name="visibility" style="width: 100%; padding: 12px; border-radius: 9px; border: 1px solid var(--border); background: #0D1124; color: white; font-size: 13px; outline: none;">
            <option value="public">Public (Everyone)</option>
            <option value="private">Private (Only Me)</option>
          </select>
        </div>
      </div>

      <!-- Submit Buttons -->
      <div style="display: flex; gap: 15px;">
        <button type="submit" class="primary-button" style="flex: 1; padding: 14px; justify-content: center; font-size: 14px;">
          Publish & Share Note <span>→</span>
        </button>
        <a href="/notes" class="secondary-button" style="padding: 14px 25px;">Cancel</a>
      </div>

    </form>
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const noteForm = document.getElementById('newNoteForm');
    const fieldSelect = document.getElementById('field');
    const branchSelect = document.getElementById('branch');
    const semesterSelect = document.getElementById('semester');
    const subjectSelect = document.getElementById('subject');
    const subjectIdInput = document.getElementById('subjectId');
    const subjectStatusText = document.getElementById('subjectStatusText');

    let branchAbortController = null;
    let subjectAbortController = null;
    let branchSeq = 0;
    let subjectSeq = 0;

    const initialSubject = '<%= typeof defaultSubject !== "undefined" ? defaultSubject : "" %>';
    const initialBranch = '<%= typeof defaultBranch !== "undefined" ? defaultBranch : "" %>';

    // 1. Load branches by field with AbortController and sequence protection
    async function loadBranches(fieldName, targetBranch) {
      if (!branchSelect) return;

      if (branchAbortController) {
        branchAbortController.abort();
      }
      branchAbortController = new AbortController();
      const currentSeq = ++branchSeq;

      branchSelect.disabled = true;
      branchSelect.innerHTML = '<option value="" style="background-color: #0D1124; color: #FFFFFF;">Loading branches...</option>';

      // While branches are loading, reset and disable subject select
      if (subjectSelect) {
        if (subjectAbortController) subjectAbortController.abort();
        subjectSelect.disabled = true;
        subjectSelect.innerHTML = '<option value="" style="background-color: #0D1124; color: #FFFFFF;">Select Branch First</option>';
        if (subjectIdInput) subjectIdInput.value = '';
      }

      try {
        const url = (fieldName && fieldName !== 'all')
          ? '/api/branches?field=' + encodeURIComponent(fieldName)
          : '/api/branches';
        const res = await fetch(url, { signal: branchAbortController.signal });
        if (!res.ok) {
          throw new Error('Academic branches request failed: ' + res.status);
        }
        const data = await res.json();

        // Discard stale responses
        if (currentSeq !== branchSeq) return;

        branchSelect.innerHTML = '<option value="" style="background-color: #0D1124; color: #FFFFFF;">Select Branch</option>';
        let selectedBranchVal = '';

        if (data.success && Array.isArray(data.branches) && data.branches.length > 0) {
          data.branches.forEach(b => {
            const opt = document.createElement('option');
            opt.value = b;
            opt.textContent = b;
            opt.style.backgroundColor = '#0D1124';
            opt.style.color = '#FFFFFF';
            if (targetBranch && b.toLowerCase() === targetBranch.toLowerCase()) {
              opt.selected = true;
              selectedBranchVal = b;
            }
            branchSelect.appendChild(opt);
          });
        }
        branchSelect.disabled = false;

        if (selectedBranchVal) {
          loadSubjects(selectedBranchVal, initialSubject);
        }
      } catch (err) {
        if (err.name === 'AbortError') return;
        if (currentSeq !== branchSeq) return;
        console.error('Error fetching branches:', err);
        branchSelect.innerHTML = '<option value="" style="background-color: #0D1124; color: #FFFFFF;">Unable to load branches. Click to retry</option>';
        branchSelect.disabled = false;
      }
    }

    // 2. Load subjects by branch with AbortController, sequence protection, and semester awareness
    async function loadSubjects(branchName, targetSubjectName) {
      if (!subjectSelect) return;

      if (!branchName || branchName.toLowerCase().startsWith('select') || branchName.toLowerCase().startsWith('unable')) {
        if (subjectAbortController) subjectAbortController.abort();
        subjectSelect.innerHTML = '<option value="" style="background-color: #0D1124; color: #FFFFFF;">Select Branch First</option>';
        subjectSelect.disabled = true;
        if (subjectIdInput) subjectIdInput.value = '';
        if (subjectStatusText) subjectStatusText.style.display = 'none';
        return;
      }

      if (subjectAbortController) {
        subjectAbortController.abort();
      }
      subjectAbortController = new AbortController();
      const currentSeq = ++subjectSeq;

      subjectSelect.disabled = true;
      subjectSelect.innerHTML = '<option value="" style="background-color: #0D1124; color: #FFFFFF;">Loading subjects...</option>';
      if (subjectStatusText) {
        subjectStatusText.textContent = 'Loading subjects...';
        subjectStatusText.style.display = 'inline';
      }

      try {
        const semesterVal = semesterSelect ? semesterSelect.value : '';
        let url = '/api/subjects?branch=' + encodeURIComponent(branchName);
        if (semesterVal) {
          url += '&semester=' + encodeURIComponent(semesterVal);
        }

        const res = await fetch(url, { signal: subjectAbortController.signal });
        if (!res.ok) {
          throw new Error('Academic subjects request failed: ' + res.status);
        }
        const data = await res.json();

        // Discard stale responses
        if (currentSeq !== subjectSeq) return;

        if (subjectStatusText) subjectStatusText.style.display = 'none';

        if (data.success && Array.isArray(data.subjects) && data.subjects.length > 0) {
          subjectSelect.innerHTML = '<option value="" style="background-color: #0D1124; color: #FFFFFF;">Select Subject</option>';
          let matchedOpt = null;

          data.subjects.forEach(s => {
            const opt = document.createElement('option');
            opt.value = s.name;
            opt.textContent = s.name + (s.code ? ' (' + s.code + ')' : '');
            opt.setAttribute('data-id', s._id);
            opt.setAttribute('data-branch', s.department || '');
            opt.style.backgroundColor = '#0D1124';
            opt.style.color = '#FFFFFF';

            if (
              targetSubjectName &&
              (s.name.toLowerCase() === targetSubjectName.toLowerCase() || String(s._id) === targetSubjectName)
            ) {
              opt.selected = true;
              matchedOpt = opt;
            }
            subjectSelect.appendChild(opt);
          });

          subjectSelect.disabled = false;

          if (matchedOpt && subjectIdInput) {
            subjectIdInput.value = matchedOpt.getAttribute('data-id') || '';
          } else if (subjectIdInput) {
            subjectIdInput.value = '';
          }
        } else {
          subjectSelect.innerHTML = '<option value="" style="background-color: #0D1124; color: #FFFFFF;">No subjects available for this branch</option>';
          subjectSelect.disabled = true;
          if (subjectIdInput) subjectIdInput.value = '';
        }
      } catch (err) {
        if (err.name === 'AbortError') return;
        if (currentSeq !== subjectSeq) return;
        console.error('Error fetching subjects:', err);
        if (subjectStatusText) subjectStatusText.style.display = 'none';
        subjectSelect.innerHTML = '<option value="" style="background-color: #0D1124; color: #FFFFFF;">Unable to load subjects. Click to retry</option>';
        subjectSelect.disabled = false;
      }
    }

    // Event: Field changes -> update branches and reset subjects
    if (fieldSelect) {
      fieldSelect.addEventListener('change', function() {
        loadBranches(this.value, '');
      });
    }

    // Event: Branch changes -> load subjects or retry
    if (branchSelect) {
      branchSelect.addEventListener('change', function() {
        if (this.value === '' && this.options[this.selectedIndex]?.textContent.includes('retry')) {
          loadBranches(fieldSelect ? fieldSelect.value : 'Engineering', '');
        } else {
          loadSubjects(this.value, '');
        }
      });
    }

    // Event: Semester changes -> refresh subjects for currently selected branch
    if (semesterSelect) {
      semesterSelect.addEventListener('change', function() {
        if (branchSelect && branchSelect.value) {
          loadSubjects(branchSelect.value, subjectSelect ? subjectSelect.value : '');
        }
      });
    }

    // Event: Subject changes -> update subjectId or retry
    if (subjectSelect) {
      subjectSelect.addEventListener('change', function() {
        if (this.value === '' && this.options[this.selectedIndex]?.textContent.includes('retry')) {
          if (branchSelect && branchSelect.value) {
            loadSubjects(branchSelect.value, '');
          }
          return;
        }
        const selectedOpt = this.options[this.selectedIndex];
        const subjectId = selectedOpt ? selectedOpt.getAttribute('data-id') : null;
        if (subjectIdInput) subjectIdInput.value = subjectId || '';
      });
    }

    // Form submission validation: Ensure required taxonomy and non-empty selections
    if (noteForm) {
      noteForm.addEventListener('submit', function(e) {
        if (branchSelect && (!branchSelect.value || branchSelect.value.trim() === '')) {
          e.preventDefault();
          alert('Please select a valid academic branch before publishing.');
          branchSelect.focus();
          return;
        }

        if (
          subjectSelect &&
          (!subjectSelect.value ||
            subjectSelect.value.trim() === '' ||
            subjectSelect.value.toLowerCase().startsWith('select') ||
            subjectSelect.value.toLowerCase().startsWith('unable') ||
            subjectSelect.value.toLowerCase().startsWith('no subjects'))
        ) {
          e.preventDefault();
          alert('Please select a valid academic subject before publishing.');
          subjectSelect.focus();
          return;
        }

        // File validation if provided
        const fileInput = document.getElementById('file');
        if (fileInput && fileInput.files && fileInput.files.length > 0) {
          const fileSizeMB = fileInput.files[0].size / (1024 * 1024);
          if (fileSizeMB > 15) {
            e.preventDefault();
            alert('The attached file exceeds the 15 MB limit. Please select a smaller file.');
            fileInput.focus();
            return;
          }
        }
      });
    }

    // Initialization on page load
    if (branchSelect && branchSelect.options.length <= 1) {
      loadBranches(fieldSelect ? fieldSelect.value : 'Engineering', initialBranch);
    } else if (branchSelect && branchSelect.value) {
      if (subjectSelect && subjectSelect.options.length <= 1) {
        loadSubjects(branchSelect.value, initialSubject);
      }
    }
  });
</script>
