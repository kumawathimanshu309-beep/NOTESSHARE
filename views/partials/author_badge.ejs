<% 
  const authorObj = typeof author !== 'undefined' && author ? author : null;
  const authorName = authorObj && authorObj.name ? authorObj.name : 'Unknown Author';
  const authorUsername = authorObj && authorObj.username ? authorObj.username : null;
  const authorRole = authorObj && authorObj.role ? authorObj.role : 'student';
  const profileUrl = authorUsername ? `/profile/${authorUsername}` : null;
%>
<div class="author-identity-badge" style="display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; max-width: 100%;">
  <% if (profileUrl) { %>
    <a href="<%= profileUrl %>" class="author-identity-link" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none; color: inherit; font-size: 12px; font-weight: 600;">
      <% if (authorObj && authorObj.avatar) { %>
        <img src="<%= authorObj.avatar %>" alt="<%= authorName %>" style="width: 20px; height: 20px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border); flex-shrink: 0;">
      <% } else { %>
        <div style="width: 20px; height: 20px; border-radius: 50%; background: var(--gradient); display: grid; place-items: center; font-size: 9px; font-weight: 700; color: white; flex-shrink: 0;">
          <%= authorName.charAt(0).toUpperCase() %>
        </div>
      <% } %>
      <span style="color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= authorName %></span>
    </a>
  <% } else { %>
    <div class="author-identity-static" style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600;">
      <div style="width: 20px; height: 20px; border-radius: 50%; background: var(--border); display: grid; place-items: center; font-size: 9px; font-weight: 700; color: var(--muted); flex-shrink: 0;">
        ?
      </div>
      <span style="color: var(--muted);"><%= authorName %></span>
    </div>
  <% } %>

  <% if (authorRole === 'teacher') { %>
    <span class="role-badge role-badge-teacher" style="display: inline-flex; align-items: center; gap: 3px; padding: 2px 7px; border-radius: 4px; background: rgba(124, 58, 237, 0.2); color: #C084FC; font-size: 10px; font-weight: 700; border: 1px solid rgba(168, 85, 247, 0.3); text-transform: uppercase; white-space: nowrap; flex-shrink: 0;">
      🎓 TEACHER
    </span>
  <% } else if (authorRole === 'admin') { %>
    <span class="role-badge role-badge-admin" style="display: inline-flex; align-items: center; gap: 3px; padding: 2px 7px; border-radius: 4px; background: rgba(239, 68, 68, 0.2); color: #F87171; font-size: 10px; font-weight: 700; border: 1px solid rgba(239, 68, 68, 0.3); text-transform: uppercase; white-space: nowrap; flex-shrink: 0;">
      🛡️ ADMIN
    </span>
  <% } else { %>
    <span class="role-badge role-badge-student" style="display: inline-flex; align-items: center; gap: 3px; padding: 2px 7px; border-radius: 4px; background: rgba(255, 255, 255, 0.08); color: var(--muted); font-size: 10px; font-weight: 700; border: 1px solid var(--border); text-transform: uppercase; white-space: nowrap; flex-shrink: 0;">
      📚 STUDENT
    </span>
  <% } %>
</div>
