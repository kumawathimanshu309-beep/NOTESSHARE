<% if ((typeof success !== 'undefined' && success && success.length > 0) || (typeof error !== 'undefined' && error && error.length > 0)) { %>
  <div class="flash-container">
    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
      <% (Array.isArray(success) ? success : [success]).forEach(msg => { %>
        <div class="flash-alert flash-success">
          <span><%= msg %></span>
          <button type="button" class="flash-dismiss" aria-label="Close">&times;</button>
        </div>
      <% }) %>
    <% } %>

    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
      <% (Array.isArray(error) ? error : [error]).forEach(msg => { %>
        <div class="flash-alert flash-error">
          <span><%= msg %></span>
          <button type="button" class="flash-dismiss" aria-label="Close">&times;</button>
        </div>
      <% }) %>
    <% } %>
  </div>
<% } %>
