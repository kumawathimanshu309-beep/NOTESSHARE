<div class="page-container" style="max-width: 600px;">
  
  <div style="margin-bottom: 25px;">
    <a href="/notes/<%= comment.note._id || comment.note %>" style="color: var(--muted); font-size: 13px; display: inline-flex; align-items: center; gap: 6px;">
      ← Back to Note
    </a>
  </div>

  <div class="content-card" style="padding: 35px; border-radius: 20px;">
    <h1 style="font-family: 'Sora', sans-serif; font-size: 22px; margin-bottom: 8px;">Edit Comment</h1>
    <p style="color: var(--muted); font-size: 13px; margin-bottom: 20px;">
      Note: <strong><%= comment.note.title || 'Study Note' %></strong>
    </p>

    <form action="/comments/<%= comment._id %>?_method=PUT" method="POST">
      <div style="margin-bottom: 20px;">
        <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 8px;">Comment Content</label>
        <textarea name="content" rows="4" required maxlength="1000" style="width: 100%; padding: 14px; border-radius: 12px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); color: white; font-family: inherit; font-size: 14px; resize: vertical;"><%= comment.content %></textarea>
      </div>

      <div style="display: flex; gap: 12px; justify-content: flex-end;">
        <a href="/notes/<%= comment.note._id || comment.note %>" class="secondary-button" style="padding: 10px 20px; font-size: 13px;">Cancel</a>
        <button type="submit" class="primary-button" style="padding: 10px 24px; font-size: 13px;">Update Comment</button>
      </div>
    </form>
  </div>

</div>
