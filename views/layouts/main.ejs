<!DOCTYPE html>

<html lang="en">

<head>

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-VMSD4M6Z1K"></script>
  <script>
    window.dataLayer = window.dataLayer || [];

    function gtag() {
      dataLayer.push(arguments);
    }

    gtag('js', new Date());
    gtag('config', 'G-VMSD4M6Z1K');
  </script>
  <!-- End Google Analytics -->

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="color-scheme" content="dark">

  <meta
    name="csrf-token"
    content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
  >

  <title>
    <%= typeof title !== 'undefined'
      ? title
      : 'StudyShare — Share Knowledge, Discover Better Notes'
    %>
  </title>

  <meta
    name="description"
    content="<%= typeof description !== 'undefined' && description
      ? description
      : 'StudyShare is an open peer-to-peer academic repository for university students and teachers to share notes, PYQs, and study materials.'
    %>"
  >

  <!-- Canonical URL -->
  <link
    rel="canonical"
    href="<%= typeof canonicalUrl !== 'undefined'
      ? canonicalUrl
      : (typeof reqUrl !== 'undefined'
        ? reqUrl
        : 'https://www.studysharehub.in/')
    %>"
  >

  <!-- OpenGraph Metadata -->
  <meta
    property="og:title"
    content="<%= typeof title !== 'undefined'
      ? title
      : 'StudyShare'
    %>"
  >

  <meta
    property="og:description"
    content="<%= typeof description !== 'undefined' && description
      ? description
      : 'Discover and share university study notes, PYQs, and academic resources on StudyShare.'
    %>"
  >

  <meta property="og:type" content="website">

  <meta
    property="og:url"
    content="<%= typeof reqUrl !== 'undefined'
      ? reqUrl
      : 'https://www.studysharehub.in/'
    %>"
  >

  <meta property="og:site_name" content="StudyShare">

  <link
    rel="icon"
    type="image/svg+xml"
    href="/favicon.svg"
  >

  <link
    rel="dns-prefetch"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="dns-prefetch"
    href="https://fonts.gstatic.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@400;600;700;800&display=swap"
  >

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9cQ2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8aA=="
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  >

  <link
    rel="stylesheet"
    href="/css/style.css?v=<%= (typeof process !== 'undefined' && process.env && process.env.VERCEL_GIT_COMMIT_SHA)
      ? process.env.VERCEL_GIT_COMMIT_SHA.slice(0, 7)
      : '765d939'
    %>"
  >

  <script
    defer
    src="/js/main.js"
  ></script>

  <script
    defer
    src="/js/blob-uploader.js"
  ></script>

</head>

<body>

  <div class="app">

    <%- include('../partials/navbar') %>

    <%- include('../partials/flash') %>

    <main>
      <%- body %>
    </main>

    <%- include('../partials/footer') %>

  </div>

</body>

</html>