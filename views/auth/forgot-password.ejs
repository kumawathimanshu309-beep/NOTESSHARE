<div class="page-container" style="max-width: 480px;">
  <div class="content-card" style="padding: 35px; border-radius: 20px;">
    <h1 style="font-family: 'Sora', sans-serif; font-size: 24px; margin-bottom: 8px;">Reset Password</h1>
    <p style="color: var(--muted); font-size: 13px; margin-bottom: 25px;">Enter your account email address to receive password reset instructions.</p>

    <form action="/auth/forgot-password" method="POST">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <div style="margin-bottom: 20px;">
        <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 8px;">Account Email</label>
        <input type="email" name="email" required placeholder="you@example.com" style="width: 100%; padding: 12px 14px; border-radius: 10px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); color: white; font-size: 14px;">
      </div>

      <button type="submit" class="primary-button" style="width: 100%; justify-content: center; padding: 12px; font-size: 14px; margin-bottom: 15px;">
        Send Reset Link
      </button>

      <div style="text-align: center;">
        <a href="/auth/login" style="font-size: 13px; color: var(--muted); text-decoration: none;">← Back to Log In</a>
      </div>
    </form>
  </div>
</div>
