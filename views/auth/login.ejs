<div class="page-container" style="max-width: 480px; margin-top: 40px;">
  <div class="content-card" style="padding: 40px 35px; border-radius: 22px; box-shadow: 0 25px 50px rgba(0,0,0,0.5);">
    
    <div style="text-align: center; margin-bottom: 25px;">
      <a href="/" class="logo" style="justify-content: center; margin-bottom: 15px;">
        <img class="w-10 h-10" src="/images/logo.png" alt="StudyShare Logo">
        <span>Study<span class="logo-purple">Share</span></span>
      </a>
      <h1 style="font-family: 'Sora', sans-serif; font-size: 26px; font-weight: 700;">Welcome Back</h1>
      <p style="color: var(--muted); font-size: 13px; margin-top: 6px;">Log in to access your saved study notes and resources</p>
    </div>

    <!-- Google Sign-In Option -->
    <div style="margin-bottom: 20px;">
      <a href="/auth/google" class="secondary-button" style="width: 100%; justify-content: center; padding: 12px; min-height: 44px; display: inline-flex; align-items: center; font-size: 13px; font-weight: 600; gap: 10px;" aria-label="Continue with Google Sign-In">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/><path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.28v3.15C3.26 21.3 7.35 24 12 24z"/><path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.28C.46 8.2.0 10.05 0 12s.46 3.8 1.28 5.42l4-3.15z"/><path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.35 0 3.26 2.7 1.28 6.58l4 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/></svg>
        Continue with Google
      </a>
    </div>

    <div style="display: flex; align-items: center; margin-bottom: 20px; color: var(--muted); font-size: 12px;">
      <div style="flex: 1; border-bottom: 1px solid var(--border);"></div>
      <span style="padding: 0 10px; text-transform: uppercase;">or email/username</span>
      <div style="flex: 1; border-bottom: 1px solid var(--border);"></div>
    </div>

    <form action="/auth/login" method="POST" id="loginForm">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      
      <div style="margin-bottom: 20px;">
        <label for="identifier" style="display: block; font-size: 12px; font-weight: 600; color: var(--text); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">Email or Username</label>
        <input 
          type="text" 
          id="identifier" 
          name="identifier" 
          value="<%= typeof formData !== 'undefined' && formData.identifier ? formData.identifier : '' %>"
          placeholder="e.g. alex@university.edu or alex99" 
          required 
          style="width: 100%; padding: 13px 16px; border-radius: 10px; border: 1px solid var(--border); background: rgba(255,255,255,0.03); color: white; font-size: 14px; outline: none; transition: 0.25s;"
        >
      </div>

      <div style="margin-bottom: 15px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <label for="password" style="font-size: 12px; font-weight: 600; color: var(--text); text-transform: uppercase; letter-spacing: 0.5px;">Password</label>
          <a href="/auth/forgot-password" style="font-size: 11px; color: var(--lavender); text-decoration: none;">Forgot Password?</a>
        </div>
        <div style="position: relative;">
          <input 
            type="password" 
            id="password" 
            name="password" 
            placeholder="••••••••" 
            required 
            style="width: 100%; padding: 13px 45px 13px 16px; border-radius: 10px; border: 1px solid var(--border); background: rgba(255,255,255,0.03); color: white; font-size: 14px; outline: none; transition: 0.25s;"
          >
          <button type="button" id="togglePassword" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: transparent; border: none; color: var(--muted); font-size: 14px; cursor: pointer;">👁️</button>
        </div>
      </div>

      <button type="submit" class="primary-button" style="width: 100%; padding: 14px; font-size: 14px; justify-content: center; margin-top: 10px;">
        Log In <span>→</span>
      </button>

    </form>

    <div style="text-align: center; margin-top: 25px; padding-top: 20px; border-top: 1px solid var(--border); font-size: 13px; color: var(--muted);">
      Don't have an account yet? 
      <a href="/auth/signup" style="color: var(--lavender); font-weight: 600; text-decoration: underline;">Sign up free</a>
    </div>

  </div>
</div>

<script>
  document.getElementById('togglePassword')?.addEventListener('click', function() {
    const passwordInput = document.getElementById('password');
    if (passwordInput.type === 'password') {
      passwordInput.type = 'text';
      this.textContent = '🙈';
    } else {
      passwordInput.type = 'password';
      this.textContent = '👁️';
    }
  });
</script>
