<div class="page-container" style="max-width: 600px;">
  
  <div style="margin-bottom: 25px;">
    <a href="/profile/<%= user.username %>" style="color: var(--muted); font-size: 13px; display: inline-flex; align-items: center; gap: 6px;">
      ← Back to Profile
    </a>
  </div>

  <div class="content-card" style="padding: 35px; border-radius: 20px;">
    <h1 style="font-family: 'Sora', sans-serif; font-size: 24px; margin-bottom: 8px;">Edit Profile</h1>
    <p style="color: var(--muted); font-size: 14px; margin-bottom: 25px;">Update your public profile information on StudyShare.</p>

    <form action="/profile/edit" method="POST">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      
      <!-- Full Name -->
      <div style="margin-bottom: 20px;">
        <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 8px;">Full Name</label>
        <input type="text" name="name" value="<%= user.name %>" required minlength="2" maxlength="50" style="width: 100%; padding: 12px 16px; border-radius: 10px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); color: white; font-size: 14px;">
      </div>

      <!-- Username -->
      <div style="margin-bottom: 20px;">
        <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 8px;">Username</label>
        <input type="text" name="username" value="<%= user.username %>" required minlength="3" maxlength="30" pattern="^[a-zA-Z0-9_-]+$" style="width: 100%; padding: 12px 16px; border-radius: 10px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); color: white; font-size: 14px;">
        <small style="color: var(--muted); font-size: 11px; margin-top: 4px; display: block;">Letters, numbers, underscores, and hyphens only.</small>
      </div>

      <!-- Account Role (Read-only security indicator) -->
      <div style="margin-bottom: 20px;">
        <label style="display: block; font-size: 13px; font-weight: 600; color: var(--muted); margin-bottom: 8px;">Account Role (System Assigned - Read Only)</label>
        <input type="text" value="<%= user.role ? user.role.toUpperCase() : 'STUDENT' %>" disabled style="width: 100%; padding: 12px 16px; border-radius: 10px; background: rgba(255,255,255,0.03); border: 1px solid var(--border); color: var(--muted); font-size: 13px; cursor: not-allowed;">
      </div>

      <!-- Bio -->
      <div style="margin-bottom: 20px;">
        <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 8px;">Short Bio</label>
        <textarea name="bio" rows="4" maxlength="250" style="width: 100%; padding: 12px 16px; border-radius: 10px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); color: white; font-size: 14px; font-family: inherit; resize: vertical;"><%= user.bio || '' %></textarea>
        <small style="color: var(--muted); font-size: 11px; margin-top: 4px; display: block;">Max 250 characters.</small>
      </div>

      <!-- Avatar URL -->
      <div style="margin-bottom: 25px;">
        <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 8px;">Avatar Image URL</label>
        <input type="text" name="avatar" value="<%= user.avatar || '' %>" placeholder="https://example.com/avatar.jpg or /images/logo.png" style="width: 100%; padding: 12px 16px; border-radius: 10px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); color: white; font-size: 14px;">
        <small style="color: var(--muted); font-size: 11px; margin-top: 4px; display: block;">Must start with http://, https://, or / (e.g. /images/logo.png).</small>
      </div>

      <% if (user.role === 'teacher') { %>
        <!-- Teacher Specific Fields -->
        <div style="border-top: 1px solid var(--border); padding-top: 20px; margin-top: 20px; margin-bottom: 20px;">
          <h3 style="font-size: 15px; color: var(--lavender); margin-bottom: 15px;">Teacher Information</h3>

          <div style="margin-bottom: 15px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 6px;">Qualification</label>
            <input type="text" name="qualification" value="<%= user.qualification || '' %>" placeholder="e.g. M.Tech Computer Science" style="width: 100%; padding: 10px 14px; border-radius: 8px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); color: white; font-size: 13px;">
          </div>

          <div style="margin-bottom: 15px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 6px;">Teaching Experience</label>
            <input type="text" name="experience" value="<%= user.experience || '' %>" placeholder="e.g. 5+ Years Senior Assistant Professor" style="width: 100%; padding: 10px 14px; border-radius: 8px; background: rgba(0,0,0,0.4); border: 1px solid var(--border); color: white; font-size: 13px;">
          </div>
        </div>
      <% } %>

      <div style="display: flex; gap: 12px; justify-content: flex-end;">
        <a href="/profile/<%= user.username %>" class="secondary-button" style="padding: 10px 20px; font-size: 13px;">Cancel</a>
        <button type="submit" class="primary-button" style="padding: 10px 24px; font-size: 13px;">Save Changes</button>
      </div>

    </form>
  </div>

</div>
